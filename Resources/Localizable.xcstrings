    "Apple doesn't send everything at once. Vane fills in as each report arrives.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ho envia tot alhora. Vane ho va omplint a mesura que arriba cada informe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sendet nicht alles auf einmal. Vane ergänzt die Daten, sobald jeder Bericht eintrifft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no envía todo a la vez. Vane se completa a medida que llega cada informe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n'envoie pas tout d'un coup. Vane se complète à l'arrivée de chaque rapport."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non invia tutto in una volta. Vane si completa man mano che arriva ogni report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple stuurt niet alles tegelijk. Vane vult aan zodra elk rapport binnenkomt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não envia tudo de uma vez. O Vane preenche os dados conforme cada relatório chega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple присылает данные не все сразу. Vane пополняется по мере поступления каждого отчёта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple her şeyi bir anda göndermez. Vane, her rapor geldikçe kendini doldurur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple skickar inte allt på en gång. Vane fyller på allt eftersom varje rapport kommer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sender ikke alt på én gang. Vane fyller på etter hvert som hver rapport kommer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple sender ikke alt på én gang. Vane udfyldes, efterhånden som hver rapport kommer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ei lähetä kaikkea kerralla. Vane täydentyy sitä mukaa, kun kukin raportti saapuu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nie wysyła wszystkiego naraz. Vane uzupełnia dane w miarę nadchodzenia raportów."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple neposílá všechno najednou. Vane se doplňuje, jak přehledy docházejí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nu trimite totul deodată. Vane completează datele pe măsură ce sosește fiecare raport."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple надсилає дані не одразу. Vane доповнює їх, коли надходить кожен звіт."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Apple δεν στέλνει τα πάντα ταυτόχρονα. Το Vane συμπληρώνει τα δεδομένα καθώς φτάνει κάθε αναφορά."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 不会一次性发送所有数据。每份报告送达后，Vane 会随之补全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 不會一次性傳送所有資料。每份報告送達後，Vane 會隨之補全。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleはすべてを一度に送信するわけではありません。各レポートが届くたびに、Vaneが順次反映します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple은 모든 보고서를 한꺼번에 보내지 않아요. Vane은 보고서가 도착할 때마다 채워 넣어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ไม่ได้ส่งทุกอย่างพร้อมกัน Vane จะเติมข้อมูลเมื่อรายงานแต่ละฉบับมาถึง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não envia tudo de uma vez. O Vane preenche os dados à medida que cada relatório chega."
          }
        }
      }
    },
    "Apple is preparing it": {
