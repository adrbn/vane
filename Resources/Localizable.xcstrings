    "Raw reports and your private key never leave this Mac. The assistant runs your own command-line tool and only sees the numbers on the screen you ask about.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes sin procesar y tu clave privada nunca salen de este Mac. El asistente ejecuta tu propia herramienta de línea de comandos y solo ve las cifras de la pantalla sobre la que preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports bruts et votre clé privée ne quittent jamais ce Mac. L'assistant utilise votre propre outil en ligne de commande et ne voit que les chiffres de l'écran concerné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I report grezzi e la tua chiave privata non lasciano mai questo Mac. L’assistente esegue il tuo strumento a riga di comando e vede solo i numeri della schermata di cui chiedi."
          }
        }
      }
    },
