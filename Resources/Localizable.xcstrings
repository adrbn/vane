    "“%@” already count from the name or subtitle. The space is better used for new words.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya cuentan desde el nombre o subtítulo. El espacio se aprovecha mejor con palabras nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » comptent déjà grâce au nom ou au sous-titre. Mieux vaut utiliser cet espace pour de nouveaux mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” già contano dal nome o dal sottotitolo. Lo spazio è meglio usato per parole nuove."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja compten des del nom o el subtítol. És millor aprofitar l'espai per a paraules noves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ zählen bereits aus dem Namen oder Untertitel. Der Platz wird besser für neue Wörter genutzt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” zaten ad veya alt başlıktan sayılıyor. Alan yeni kelimeler için daha iyi kullanılır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже учитываются из названия или подзаголовка. Это место лучше занять новыми словами."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tellen al mee vanuit de naam of ondertitel. De ruimte kun je beter voor nieuwe woorden gebruiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já contam pelo nome ou subtítulo. O espaço rende mais com palavras novas."
          }
        }
      }
    },
