            "value": "El uso sale del informe de analíticas de Apple, uno o dos días después de la primera instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utilisation vient du rapport d'analyse d'Apple, un ou deux jours après la première installation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilizzo proviene dal report di analisi di Apple, uno o due giorni dopo la prima installazione."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ús ve de l'informe d'analítica d'Apple, un o dos dies després de la primera instal·lació."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung stammt aus dem Analytics-Bericht von Apple, ein bis zwei Tage nach der ersten Installation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım, Apple'ın analiz raporundan gelir; ilk kurulumdan bir iki gün sonra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные об использовании берутся из аналитического отчёта Apple через один–два дня после первой установки."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik komt uit Apples analyserapport, een of twee dagen na de eerste installatie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O uso vem do relatório de análises da Apple, um ou dois dias após a primeira instalação."
          }
        }
      }
    },
    "Use key %@ from your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la clave %@ de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser la clé %@ de votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la chiave %@ dal tuo Mac."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir la clau %@ del teu Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel %@ von Ihrem Mac verwenden."
          }
        },
        "tr": {
