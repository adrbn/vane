    "Apple's analytics start on %@, so these figures count from then. ": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analítica d'Apple comença el %@, així que aquestes xifres compten des de llavors. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples Analysen beginnen am %@, daher zählen diese Zahlen ab dann. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las analíticas de Apple empiezan el %@, así que estas cifras cuentan desde entonces. "
