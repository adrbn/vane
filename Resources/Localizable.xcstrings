    "A busy %@ for downloads.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un %@ mogut de baixades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viel los bei den Downloads (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ con muchas descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre %@ : beaucoup de téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ intenso per i download."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een drukke %@ voor downloads."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Período movimentado (%@) para downloads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки: оживлённый период (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirmeler için yoğun bir %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livlig aktivitet för nedladdningar, %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mye aktivitet på nedlastinger, %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Meget aktivitet på downloads, %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilkas %@ latauksille."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruchliwy okres pod względem pobrań (%@)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rušné období pro stažení (%@)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ aglomerată la descărcări."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний період (%@) для завантажень."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια πολυσύχναστη περίοδος (%@) για τις λήψεις."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个%@的下载量相当活跃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個%@的下載量相當活躍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%@はダウンロードが活発でした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
