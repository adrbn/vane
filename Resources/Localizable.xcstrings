    "First-time downloads: %@. Redownloads: %@. Apple's analytics for this app start on %@, so this %@ has no impressions or product page views.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "First-time downloads: %1$@. Redownloads: %2$@. Apple's analytics for this app start on %3$@, so this %4$@ has no impressions or product page views."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeres descàrregues: %@. Redescàrregues: %@. L'analítica d'Apple d'aquesta app comença el %@, així que aquest %@ no té impressions ni visites a la pàgina del producte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstdownloads: %@. Erneute Downloads: %@. Apples Analysen für diese App beginnen am %@, daher hat dieser Zeitraum (%@) keine Impressionen oder Produktseitenaufrufe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeras descargas: %@. Redescargas: %@. Las analíticas de Apple de esta app empiezan el %@, así que este %@ no tiene impresiones ni visitas a la página del producto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiers téléchargements : %@. Retéléchargements : %@. Les analyses d'Apple pour cette app commencent le %@ : cette période (%@) n'a donc ni impressions ni vues de la page produit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primi download: %@. Nuovi download: %@. Le analisi di Apple per questa app iniziano il %@, quindi questo periodo (%@) non ha impressioni né visualizzazioni della pagina prodotto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste downloads: %@. Herdownloads: %@. Apples analyses voor deze app beginnen op %@, dus deze periode (%@) heeft geen vertoningen of productpaginaweergaven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiros downloads: %@. Novos downloads: %@. As análises da Apple para este app começam em %@, então este período (%@) não tem impressões nem visualizações da página do produto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первые загрузки: %@. Повторные загрузки: %@. Аналитика Apple для этого приложения начинается %@, поэтому за этот период (%@) нет показов и просмотров страницы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk indirmeler: %@. Yeniden indirmeler: %@. Bu uygulama için Apple analizleri %@ tarihinde başlıyor, bu yüzden bu dönemde (%@) gösterim ya da ürün sayfası görüntülemesi yok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förstagångsnedladdningar: %1$@. Omnedladdningar: %2$@. Apples analys för den här appen börjar %3$@, så den här perioden (%4$@) har inga visningar eller produktsidvisningar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Førstegangsnedlastinger: %1$@. Nedlastinger på nytt: %2$@. Apples analyse for denne appen starter %3$@, så denne perioden (%4$@) har ingen visninger eller produktsidevisninger."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Førstegangsdownloads: %1$@. Gendownloads: %2$@. Apples analyse for denne app starter %3$@, så denne periode (%4$@) har ingen visninger eller produktsidevisninger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensilataukset: %1$@. Uudelleenlataukset: %2$@. Applen analytiikka tälle sovellukselle alkaa %3$@, joten tässä jaksossa (%4$@) ei ole näyttökertoja eikä tuotesivun katseluja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsze pobrania: %1$@. Ponowne pobrania: %2$@. Analityka Apple dla tej aplikacji zaczyna się %3$@, więc w tym okresie (%4$@) nie ma wyświetleń ani odsłon strony produktu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "První stažení: %1$@. Opakovaná stažení: %2$@. Analytika Applu pro tuto aplikaci začíná %3$@, takže pro toto období (%4$@) nejsou k dispozici zobrazení ani zobrazení stránky produktu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prime descărcări: %1$@. Redescărcări: %2$@. Analizele Apple pentru această aplicație încep la %3$@, deci acest %4$@ nu are afișări sau vizualizări ale paginii de produs."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перші завантаження: %1$@. Повторні завантаження: %2$@. Аналітика Apple для цього застосунку починається з %3$@, тож у цьому періоді (%4$@) немає показів чи переглядів сторінки продукту."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρώτες λήψεις: %1$@. Επαναλήψεις λήψης: %2$@. Οι αναλύσεις της Apple για αυτήν την εφαρμογή ξεκινούν στις %3$@, οπότε αυτό το %4$@ δεν έχει εμφανίσεις ή προβολές σελίδας προϊόντος."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次下载：%1$@。重新下载：%2$@。Apple 对此 App 的分析数据从 %3$@ 开始，因此这个%4$@没有展示次数或产品页面查看次数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次下載：%1$@。重新下載：%2$@。Apple 對此 App 的分析資料從 %3$@ 開始，因此這個%4$@沒有曝光次數或產品頁面檢視次數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回ダウンロード: %1$@。再ダウンロード: %2$@。このAppに対するAppleの分析は%3$@から始まるため、この%4$@にはインプレッションやプロダクトページビューがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 다운로드: %1$@. 재다운로드: %2$@. 이 앱의 Apple 분석은 %3$@부터 시작되므로 이 %4$@에는 노출수나 제품 페이지 조회수가 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดครั้งแรก: %1$@ ดาวน์โหลดซ้ำ: %2$@ การวิเคราะห์ของ Apple สำหรับแอปนี้เริ่มตั้งแต่ %3$@ %4$@นี้จึงไม่มีการแสดงผลหรือการดูหน้าผลิตภัณฑ์"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiras transferências: %1$@. Retransferências: %2$@. As análises da Apple para esta app começam a %3$@, por isso este período (%4$@) não tem impressões nem visualizações da página do produto."
          }
        }
