        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj kod w aplikacji na iPhone'a, aby używać tam tego samego klucza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naskenujte kód v aplikaci pro iPhone, abyste tam používali stejný klíč."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
