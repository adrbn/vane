    "The subtitle is indexed for search and shown under your name. 30 free characters are going unused.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El subtítol s'indexa per a la cerca i es mostra sota el nom. Hi ha 30 caràcters lliures sense usar."
          }
        },
        "de": {
          "stringUnit": {
