          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäinen App Store -raporttisi saapuu 24–48 tunnissa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój pierwszy raport z App Store pojawi się za 24–48 godzin"
          }
        },
        "cs": {
