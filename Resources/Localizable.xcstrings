            "value": "Aynı anahtarı orada kullanmak için iPhone uygulamasıyla bir kod tarayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanna en kod med iPhone-appen för att använda samma nyckel där."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skann en kode med iPhone-appen for å bruke samme nøkkel der."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan en kode med iPhone-appen for at bruge den samme nøgle dér."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Skannaa koodi iPhone-sovelluksella käyttääksesi samaa avainta siellä."
