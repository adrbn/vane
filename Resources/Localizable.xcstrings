            "state": "translated",
            "value": "Beantwoord recensies en verbeter je metadata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda resenhas e corrija seus metadados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвечайте на отзывы и исправляйте метаданные."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yorumları yanıtlayın ve meta verilerinizi düzeltin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svara på recensioner och rätta dina metadata."
          }
        },
