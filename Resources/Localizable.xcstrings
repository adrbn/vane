            "value": "Váš první přehled z App Storu dorazí za 24–48 hodin"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primul tău raport App Store ajunge în 24–48 de ore"
          }
        },
        "uk": {
