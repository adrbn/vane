    " Active subscriptions ended at %@, %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " Active subscriptions ended at %1$@, %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las suscripciones activas terminaron en %@, %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Abonnements actifs en fin de période : %@, %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Gli abbonamenti attivi sono terminati a %@, %@."
          }
        }
      }
    },
    " Downloads barely moved, so the change came from what people bought.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las descargas apenas variaron, así que el cambio vino de lo que compró la gente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les téléchargements ont peu bougé : la variation vient de ce que les gens ont acheté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " I download sono rimasti quasi invariati: il cambiamento dipende da ciò che le persone hanno acquistato."
          }
        }
      }
    },
    " Figures through %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Cifras hasta el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Chiffres jusqu'au %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Dati fino a %@."
          }
        }
      }
    },
    " That is %@ ratings per 1,000 first-time downloads.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Son %@ valoraciones por cada 1000 primeras descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Soit %@ notes pour 1 000 premiers téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Sono %@ valutazioni ogni 1.000 primi download."
          }
        }
      }
    },
    " With downloads nearly unchanged, the growth came from what people bought rather than from more visitors.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Con las descargas casi sin cambios, el crecimiento vino de lo que compró la gente y no de más visitantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Avec des téléchargements presque stables, la hausse vient de ce que les gens ont acheté, pas d'un surplus de visiteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Con download quasi invariati, la crescita è dovuta a ciò che le persone hanno acquistato, non a più visitatori."
          }
        }
      }
    },
