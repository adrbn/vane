    "Shows a QR code the iPhone's Camera can scan to connect with this key.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codi QR que la càmera de l'iPhone pot escanejar per connectar-se amb aquesta clau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen QR-Code, den die Kamera des iPhone scannen kann, um sich mit diesem Schlüssel zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un código QR que la cámara del iPhone puede escanear para conectarse con esta clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un code QR que l'appareil photo de l'iPhone peut scanner pour se connecter avec cette clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codice QR che la Fotocamera dell’iPhone può inquadrare per connettersi con questa chiave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een QR-code die de camera van de iPhone kan scannen om met deze sleutel te verbinden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um código QR que a Câmera do iPhone pode ler para conectar com esta chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает QR-код, который можно отсканировать камерой iPhone, чтобы подключиться с этим ключом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Kamerası'nın bu anahtarla bağlanmak için tarayabileceği bir QR kodu gösterir."
          }
        }
      }
    },
    "Shows a QR code. Scan it with the iPhone's Camera and Vane connects with this key.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codi QR. Escaneja'l amb la càmera de l'iPhone i Vane es connecta amb aquesta clau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen QR-Code. Scannen Sie ihn mit der Kamera des iPhone, und Vane verbindet sich mit diesem Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un código QR. Escanéalo con la cámara del iPhone y Vane se conecta con esta clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un code QR. Scannez-le avec l'appareil photo de l'iPhone et Vane se connecte avec cette clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codice QR. Inquadralo con la Fotocamera dell’iPhone e Vane si connette con questa chiave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een QR-code. Scan die met de camera van de iPhone en Vane verbindt met deze sleutel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um código QR. Leia-o com a Câmera do iPhone e o Vane se conecta com esta chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает QR-код. Отсканируйте его камерой iPhone, и Vane подключится с этим ключом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir QR kodu gösterir. iPhone Kamerası ile tarayın, Vane bu anahtarla bağlanır."
          }
        }
      }
    },
