    "Crashes per session are %@× last month's rate. Check crash reports in Xcode Organizer, starting with recent releases.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fallades per sessió són %@× la taxa del mes passat. Revisa els informes de fallades a Xcode Organizer, començant per les versions recents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abstürze pro Sitzung liegen beim %@-Fachen des Vormonats. Prüfen Sie die Absturzberichte im Xcode Organizer, beginnend mit den neuesten Releases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fallos por sesión son %@× la tasa del mes pasado. Revisa los informes de fallos en Xcode Organizer, empezando por las versiones recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantages par session atteignent %@× le taux du mois dernier. Consultez les rapports de plantage dans l'Organizer de Xcode, en commençant par les versions récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I crash per sessione sono %@× il tasso del mese scorso. Controlla i report dei crash in Xcode Organizer, partendo dalle versioni più recenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Crashes per sessie zijn %@× het niveau van vorige maand. Bekijk crashrapporten in Xcode Organizer, te beginnen met recente releases."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As falhas por sessão estão %@× acima da taxa do mês passado. Confira os relatórios de falhas no Xcode Organizer, começando pelas versões recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбоев на сеанс: %@× от показателя прошлого месяца. Проверьте отчёты о сбоях в Xcode Organizer, начиная с последних релизов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum başına çökmeler geçen ay oranının %@ katı. Xcode Organizer'daki çökme raporlarını, en son sürümlerden başlayarak kontrol edin."
          }
        }
      }
    },
    "Create a key": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una clau"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel erstellen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una clave"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une clé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una chiave"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een sleutel aan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar uma chave"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать ключ"
          }
        },
        "tr": {
