          "stringUnit": {
            "state": "translated",
            "value": "Svar på anmeldelser og rett opp metadataene dine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Besvar anmeldelser og ret dine metadata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaa arvosteluihin ja korjaa metatietosi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiadaj na recenzje i popraw metadane."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovídejte na recenze a opravte svá metadata."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunde la recenzii și îmbunătățește-ți metadatele."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідайте на відгуки та виправляйте метадані."
          }
