              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vane порівняв %lld показників зі звичним діапазоном. Усе нормально, тож сьогодні нічого робити не треба. Нові інсайти з’являться тут, коли показник вийде за діапазон або відгук потребуватиме вашої уваги."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vane порівняв %lld показника зі звичним діапазоном. Усе нормально, тож сьогодні нічого робити не треба. Нові інсайти з’являться тут, коли показник вийде за діапазон або відгук потребуватиме вашої уваги."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Το Vane σύγκρινε %lld μέτρηση με το συνηθισμένο της εύρος. Όλα είναι φυσιολογικά, οπότε δεν υπάρχει κάτι να κάνετε σήμερα. Νέες πληροφορίες εμφανίζονται εδώ όταν μια μέτρηση βγει εκτός εύρους ή μια κριτική σας χρειαστεί."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Το Vane σύγκρινε %lld μετρήσεις με το συνηθισμένο τους εύρος. Όλα είναι φυσιολογικά, οπότε δεν υπάρχει κάτι να κάνετε σήμερα. Νέες πληροφορίες εμφανίζονται εδώ όταν μια μέτρηση βγει εκτός εύρους ή μια κριτική σας χρειαστεί."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vane 已将 %lld 项指标与其常规范围进行比较。一切正常，今天没有需要处理的事项。当某项指标超出范围或有评论需要你处理时，新的洞察会出现在这里。"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vane 已將 %lld 項指標與其常規範圍進行比較。一切正常，今天沒有需要處理的事項。當某項指標超出範圍或有評論需要你處理時，新的洞察會出現在這裡。"
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vaneは%lld個の指標を通常の範囲と比較しました。すべて正常で、今日対応が必要なことはありません。指標が範囲を外れたり、レビューへの対応が必要になったりすると、新しいインサイトがここに表示されます。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vane이 지표 %lld개를 평소 범위와 비교했어요. 모두 정상이라 오늘은 할 일이 없어요. 지표가 범위를 벗어나거나 리뷰에 답해야 할 때 새 인사이트가 여기에 나타나요."
                }
              }
            }
          }
        },
        "th": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vane เปรียบเทียบตัวชี้วัด %lld รายการกับช่วงปกติ ทุกอย่างปกติดี วันนี้จึงไม่มีอะไรต้องทำ ข้อมูลเชิงลึกใหม่จะปรากฏที่นี่เมื่อตัวชี้วัดหลุดช่วงปกติหรือมีรีวิวที่ต้องดู"
                }
              }
            }
          }
        },
        "pt-PT": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Vane comparou %lld métrica com o seu intervalo habitual. Está tudo normal, por isso não há nada a fazer hoje. Novas informações aparecem aqui quando uma métrica sai do intervalo ou uma avaliação precisa de si."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O Vane comparou %lld métricas com o seu intervalo habitual. Está tudo normal, por isso não há nada a fazer hoje. Novas informações aparecem aqui quando uma métrica sai do intervalo ou uma avaliação precisa de si."
                }
              }
            }
          }
        }
      }
    },
