          }
        }
      }
    },
    "Vane reads your reports with an API key. The key stays in your Keychain and never leaves this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane lee tus informes con una clave de API. La clave se queda en tu Llavero y nunca sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane lit vos rapports avec une clé API. La clé reste dans votre trousseau et ne quitte jamais ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane legge i tuoi report con una chiave API. La chiave resta nel tuo Portachiavi e non lascia mai questo Mac."
          }
        }
      }
    },
    "Vane watches %lld of %lld metrics so far and none needs you. The others start once Apple's first analytics report arrives, usually 24–48 hours after you connect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Vane watches %1$lld of %2$lld metrics so far and none needs you. The others start once Apple's first analytics report arrives, usually 24–48 hours after you connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane vigila %lld de %lld métricas por ahora y ninguna te necesita. Las demás empiezan cuando llega el primer informe de analíticas de Apple, normalmente 24–48 horas después de conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane surveille pour l'instant %lld indicateurs sur %lld, et aucun ne demande votre attention. Les autres démarrent avec le premier rapport d'analyse d'Apple, généralement 24 à 48 heures après la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finora Vane tiene d’occhio %lld metriche su %lld e nessuna richiede la tua attenzione. Le altre partono quando arriva il primo report di analisi di Apple, di solito 24–48 ore dopo la connessione."
          }
        }
      }
    },
