    "Arrives with Apple's first analytics report": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba amb el primer informe d'analítica d'Apple"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt mit dem ersten Analytics-Bericht von Apple"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega con el primer informe de analíticas de Apple"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive avec le premier rapport d'analyse d'Apple"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva con il primo report di analisi di Apple"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt binnen met Apples eerste analyserapport"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chega com o primeiro relatório de análises da Apple"
          }
        },
        "ru": {
