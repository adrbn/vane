    "Next: %@, about %lld weeks at this pace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Next: %1$@, about %2$lld weeks at this pace"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Següent: %@, unes %lld setmanes a aquest ritme"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächster: %@, etwa %lld Wochen bei diesem Tempo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente: %@, unas %lld semanas a este ritmo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prochain : %@, environ %lld semaines à ce rythme"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossimo: %@, circa %lld settimane a questo ritmo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volgende: %@, ongeveer %lld weken in dit tempo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo: %@, cerca de %lld semanas a este ritmo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий: %@, примерно %lld нед. в этом темпе"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki: %@, bu hızla yaklaşık %lld hafta"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa: %1$@, om ungefär %2$lld veckor i den här takten"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste: %1$@, om omtrent %2$lld uker i dette tempoet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Næste: %1$@, om ca. %2$lld uger i dette tempo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava: %1$@, noin %2$lld viikon päästä tällä vauhdilla"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następne: %1$@, za około %2$lld tyg. w tym tempie"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další: %1$@, při tomto tempu asi za %2$lld týdnů"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Următorul: %1$@, în aproximativ %2$lld săptămâni în ritmul actual"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далі: %1$@, приблизно через %2$lld тижн. за такого темпу"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επόμενο: %1$@, σε περίπου %2$lld εβδομάδες με αυτόν τον ρυθμό"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个：%1$@，按此速度约需 %2$lld 周"
          }
        },
        "zh-Hant": {
          "stringUnit": {
