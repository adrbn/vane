    "This code holds your private key. Don't screenshot or share it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest codi conté la teva clau privada. No en facis captures ni el comparteixis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code enthält Ihren privaten Schlüssel. Machen Sie keinen Screenshot und teilen Sie ihn nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código contiene tu clave privada. No hagas capturas ni lo compartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code contient votre clé privée. Ne le capturez pas et ne le partagez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice contiene la tua chiave privata. Non farne screenshot e non condividerlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code bevat je privésleutel. Maak er geen schermafbeelding van en deel hem niet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código contém sua chave privada. Não tire captura de tela nem o compartilhe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код содержит ваш закрытый ключ. Не делайте с ним скриншоты и не делитесь им."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod özel anahtarınızı içerir. Ekran görüntüsünü almayın veya paylaşmayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här koden innehåller din privata nyckel. Ta inte skärmdump av den och dela den inte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne koden inneholder den private nøkkelen din. Ikke ta skjermbilde av den eller del den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kode indeholder din private nøgle. Tag ikke skærmbillede af den, og del den ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä koodi sisältää yksityisen avaimesi. Älä ota siitä kuvakaappausta äläkä jaa sitä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod zawiera Twój klucz prywatny. Nie rób jego zrzutu ekranu i nie udostępniaj go."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento kód obsahuje váš soukromý klíč. Nepořizujte jeho snímek obrazovky ani ho nesdílejte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cod conține cheia ta privată. Nu-l captura și nu-l distribui."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей код містить ваш закритий ключ. Не робіть його скриншотів і не діліться ним."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο κωδικός περιέχει το ιδιωτικό κλειδί σας. Μην τον φωτογραφίσετε και μην τον μοιραστείτε."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此二维码包含你的私钥。请勿截屏或分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此QR 碼包含你的私密金鑰。請勿截圖或分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードには秘密鍵が含まれています。スクリーンショットや共有はしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 코드에는 개인 키가 들어 있어요. 스크린샷을 찍거나 공유하지 마세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสนี้มีคีย์ส่วนตัวของคุณ อย่าแคปหน้าจอหรือแชร์"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código contém a sua chave privada. Não faça captura de ecrã nem o partilhe."
          }
        }
      }
    },
    "This device can't scan. Point the iPhone's Camera at the code instead, or use your own key.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu no pot escanejar. Apunta la càmera de l'iPhone al codi o fes servir la teva pròpia clau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann nicht scannen. Richten Sie stattdessen die Kamera des iPhone auf den Code oder verwenden Sie Ihren eigenen Schlüssel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede escanear. Apunta la cámara del iPhone al código o usa tu propia clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas scanner. Pointez plutôt l'appareil photo de l'iPhone vers le code, ou utilisez votre propre clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può inquadrare codici. Punta invece la Fotocamera dell’iPhone sul codice, oppure usa la tua chiave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan niet scannen. Richt in plaats daarvan de camera van de iPhone op de code, of gebruik je eigen sleutel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não consegue ler códigos. Aponte a Câmera do iPhone para o código ou use sua própria chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может сканировать. Наведите камеру iPhone на код или используйте собственный ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz tarama yapamıyor. Bunun yerine iPhone Kamerası'nı koda doğrultun veya kendi anahtarınızı kullanın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten kan inte skanna. Rikta iPhones kamera mot koden i stället, eller använd din egen nyckel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten kan ikke skanne. Pek kameraet på iPhone mot koden i stedet, eller bruk din egen nøkkel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed kan ikke scanne. Ret kameraet på iPhone mod koden i stedet, eller brug din egen nøgle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei voi skannata. Osoita sen sijaan iPhonen Kameralla koodia tai käytä omaa avaintasi."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie może skanować. Skieruj aparat iPhone'a na kod lub użyj własnego klucza."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení neumí skenovat. Namiřte místo toho fotoaparát iPhonu na kód, nebo použijte vlastní klíč."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu poate scana. Îndreaptă camera iPhone-ului spre cod sau folosește propria cheie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не може сканувати. Наведіть камеру iPhone на код або використайте власний ключ."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συσκευή δεν μπορεί να σαρώσει. Στρέψτε την Κάμερα του iPhone στον κωδικό ή χρησιμοποιήστε το δικό σας κλειδί."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法扫描。请改用 iPhone 的“相机”对准二维码，或使用你自己的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法掃描。請改用 iPhone 的「相機」對準QR 碼，或使用你自己的金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではスキャンできません。代わりにiPhoneのカメラをコードに向けるか、ご自身のキーを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 스캔할 수 없어요. 대신 iPhone의 카메라로 코드를 비추거나 내 키를 사용하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้สแกนไม่ได้ ให้เล็งกล้องของ iPhone ไปที่รหัสแทน หรือใช้คีย์ของคุณเอง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não consegue ler códigos. Aponte antes a Câmara do iPhone ao código ou use a sua própria chave."
          }
        }
      }
    },
