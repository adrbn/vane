    "Demo data: three made-up apps. Your own data isn't touched.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de demostración: tres apps inventadas. Tus datos no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données de démo : trois apps fictives. Vos données ne sont pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati demo: tre app inventate. I tuoi dati non vengono toccati."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Dades de demostració: tres apps inventades. Les teves dades no es toquen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Demodaten: drei erfundene Apps. Ihre eigenen Daten bleiben unberührt."
