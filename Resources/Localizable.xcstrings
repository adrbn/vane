    "Claude Code is signed out. Run claude /login in Terminal, then try again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code té la sessió tancada. Executa claude /login al Terminal i torna-ho a provar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist abgemeldet. Führen Sie claude /login im Terminal aus und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ha cerrado la sesión. Ejecuta claude /login en Terminal y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code est déconnecté. Exécutez claude /login dans Terminal, puis réessayez."
          }
