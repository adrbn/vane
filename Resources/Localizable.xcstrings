    "Leave empty for your usual account. For another one, sign in with CLAUDE_CONFIG_DIR=<folder> claude, then enter that folder.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa-ho buit per al teu compte habitual. Per a un altre, inicia sessió amb CLAUDE_CONFIG_DIR=<carpeta> claude i escriu aquí aquella carpeta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen für dein übliches Konto. Für ein anderes melde dich mit CLAUDE_CONFIG_DIR=<Ordner> claude an und gib dann diesen Ordner ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para tu cuenta habitual. Para otra, inicia sesión con CLAUDE_CONFIG_DIR=<carpeta> claude y luego escribe esa carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour votre compte habituel. Pour un autre, connectez-vous avec CLAUDE_CONFIG_DIR=<dossier> claude, puis indiquez ce dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per il tuo account abituale. Per un altro, accedi con CLAUDE_CONFIG_DIR=<cartella> claude, poi inserisci quella cartella."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg voor je gewone account. Voor een ander log je in met CLAUDE_CONFIG_DIR=<map> claude en vul je die map hier in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para a sua conta de sempre. Para outra, faça login com CLAUDE_CONFIG_DIR=<pasta> claude e depois informe essa pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым для обычного аккаунта. Для другого войдите через CLAUDE_CONFIG_DIR=<папка> claude и укажите эту папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki hesabınız için boş bırakın. Başka biri için CLAUDE_CONFIG_DIR=<klasör> claude ile oturum açın, sonra o klasörü girin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för ditt vanliga konto. För ett annat, logga in med CLAUDE_CONFIG_DIR=<mapp> claude och ange sedan den mappen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La stå tomt for den vanlige kontoen din. For en annen, logg inn med CLAUDE_CONFIG_DIR=<mappe> claude, og skriv deretter inn den mappen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad feltet stå tomt for din sædvanlige konto. For en anden: log ind med CLAUDE_CONFIG_DIR=<mappe> claude, og indtast derefter den mappe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä tyhjäksi tavallista tiliäsi varten. Toista tiliä varten kirjaudu sisään komennolla CLAUDE_CONFIG_DIR=<kansio> claude ja anna sitten tuo kansio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw puste dla zwykłego konta. Dla innego zaloguj się poleceniem CLAUDE_CONFIG_DIR=<folder> claude, a następnie wpisz ten folder."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro svůj obvyklý účet nechte prázdné. Pro jiný se přihlaste příkazem CLAUDE_CONFIG_DIR=<složka> claude a zadejte tuto složku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă gol pentru contul obișnuit. Pentru altul, autentifică-te cu CLAUDE_CONFIG_DIR=<folder> claude, apoi introdu acel folder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім для звичного облікового запису. Для іншого увійдіть через CLAUDE_CONFIG_DIR=<папка> claude, а потім введіть цю папку."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε κενό για τον συνηθισμένο λογαριασμό σας. Για άλλον, συνδεθείτε με CLAUDE_CONFIG_DIR=<φάκελος> claude και εισαγάγετε αυτόν τον φάκελο."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空则使用常用账户。若要使用其他账户，请用 CLAUDE_CONFIG_DIR=<文件夹> claude 登录，然后输入该文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空則使用常用帳號。若要使用其他帳號，請用 CLAUDE_CONFIG_DIR=<資料夾> claude 登入，然後輸入該資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄のままにすると通常のアカウントを使います。別のアカウントを使うには、CLAUDE_CONFIG_DIR=<フォルダ> claude でサインインし、そのフォルダを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 계정을 쓰려면 비워 두세요. 다른 계정을 쓰려면 CLAUDE_CONFIG_DIR=<폴더> claude로 로그인한 다음 그 폴더를 입력하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เว้นว่างไว้เพื่อใช้บัญชีปกติของคุณ หากต้องการใช้บัญชีอื่น ให้ลงชื่อเข้าใช้ด้วย CLAUDE_CONFIG_DIR=<โฟลเดอร์> claude แล้วป้อนโฟลเดอร์นั้น"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para a sua conta habitual. Para outra, inicie sessão com CLAUDE_CONFIG_DIR=<pasta> claude e introduza essa pasta."
          }
        }
      }
    },
