    "You got %@ downloads on %@, more than any day since %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You got %1$@ downloads on %2$@, more than any day since %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseguiste %@ descargas el %@, más que cualquier día desde el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ téléchargements le %@, plus que n'importe quel jour depuis le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ottenuto %@ download il %@, più di qualsiasi giorno dal %@."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has tingut %1$@ baixades el %2$@, més que cap dia des de %3$@."
