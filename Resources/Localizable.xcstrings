    "Every 6 hours, even when Vane is closed. You'll get a notification when something needs attention.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 6 hores, fins i tot amb Vane tancat. Rebràs una notificació quan alguna cosa requereixi atenció."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 6 Stunden, auch wenn Vane geschlossen ist. Sie werden benachrichtigt, wenn etwas Aufmerksamkeit braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 6 horas, incluso con Vane cerrado. Recibirás una notificación cuando algo requiera atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 6 heures, même quand Vane est fermée. Vous recevez une notification quand quelque chose demande votre attention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 6 ore, anche quando Vane è chiuso. Riceverai una notifica quando qualcosa richiede attenzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke 6 uur, ook als Vane gesloten is. Je krijgt een melding als er iets aandacht nodig heeft."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 6 horas, mesmo com o Vane fechado. Você receberá uma notificação quando algo precisar de atenção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждые 6 часов, даже когда Vane закрыт. Вы получите уведомление, когда что-то потребует внимания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane kapalıyken bile 6 saatte bir. Dikkat gerektiren bir şey olduğunda bildirim alırsınız."
          }
        }
      }
    },
    "Every 6 hours, even when the window is closed. Listed in Login Items.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 6 hores, fins i tot amb la finestra tancada. Apareix als Ítems d'inici de sessió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 6 Stunden, auch wenn das Fenster geschlossen ist. Wird in den Anmeldeobjekten aufgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 6 horas, incluso con la ventana cerrada. Aparece en Ítems de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 6 heures, même quand la fenêtre est fermée. Visible dans Ouverture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 6 ore, anche quando la finestra è chiusa. Elencato negli elementi login."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke 6 uur, ook als het venster gesloten is. Staat bij Inloggen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 6 horas, mesmo com a janela fechada. Aparece nos Itens de Início de Sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждые 6 часов, даже когда окно закрыто. Указано в объектах входа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencere kapalıyken bile 6 saatte bir. Oturum Açma Öğeleri'nde listelenir."
          }
        }
      }
    },
