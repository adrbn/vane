    "A reply often turns a 1-star review into an update. %lld of your last 10 reviews are 1–2 stars without a response.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A reply often turns a 1-star review into an update. %lld of your last 10 reviews is 1–2 stars without a response."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A reply often turns a 1-star review into an update. %lld of your last 10 reviews are 1–2 stars without a response."
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respuesta suele convertir una reseña de 1 estrella en una actualización. %lld de tus últimas 10 reseñas son de 1–2 estrellas sin respuesta."
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une réponse transforme souvent un avis 1 étoile en avis mis à jour. %lld de vos 10 derniers avis a 1 ou 2 étoiles et aucune réponse."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une réponse transforme souvent un avis 1 étoile en avis mis à jour. %lld de vos 10 derniers avis ont 1 ou 2 étoiles et aucune réponse."
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta spesso trasforma una recensione da 1 stella in un aggiornamento. %lld delle tue ultime 10 recensioni hanno 1–2 stelle e nessuna risposta."
          }
        },
        "ca": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una resposta sovint converteix una ressenya d'1 estrella en una actualització. %lld de les teves últimes 10 ressenyes és d'1–2 estrelles sense resposta."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una resposta sovint converteix una ressenya d'1 estrella en una actualització. %lld de les teves últimes 10 ressenyes són d'1–2 estrelles sense resposta."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine Antwort macht aus einer 1-Stern-Rezension oft ein Update. %lld Ihrer letzten 10 Rezensionen hat 1–2 Sterne und keine Antwort."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine Antwort macht aus einer 1-Stern-Rezension oft ein Update. %lld Ihrer letzten 10 Rezensionen haben 1–2 Sterne und keine Antwort."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Bir yanıt, 1 yıldızlı bir yorumu çoğu zaman güncellemeye dönüştürür. Son 10 yorumunuzdan %lld tanesi yanıtsız 1–2 yıldızlı yorum."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Bir yanıt, 1 yıldızlı bir yorumu çoğu zaman güncellemeye dönüştürür. Son 10 yorumunuzdan %lld tanesi yanıtsız 1–2 yıldızlı yorum."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ответ часто побуждает автора пересмотреть отзыв в 1 звезду. Без ответа остаётся %lld из последних 10 отзывов с оценкой 1–2 звезды."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
