            "state": "translated",
            "value": "Ваш перший звіт App Store надійде через 24–48 годин"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η πρώτη σας αναφορά App Store φτάνει σε 24–48 ώρες"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的首份 App Store 报告将在 24–48 小时内送达"
