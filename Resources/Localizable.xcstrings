    "Not enough data for a full month yet.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha prou dades per a un mes complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht genug Daten für einen vollen Monat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay datos suficientes para un mes completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore assez de données pour un mois complet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati ancora insufficienti per un mese completo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet genoeg gegevens voor een volledige maand."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há dados suficientes para um mês completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данных за полный месяц пока недостаточно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam bir ay için henüz yeterli veri yok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med data för en hel månad än."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok data for en hel måned ennå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok data til en hel måned endnu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietoja ei ole vielä kokonaiseen kuukauteen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało danych na pełny miesiąc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není dost dat na celý měsíc."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu sunt destule date pentru o lună completă."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Даних для повного місяця ще недостатньо."
          }
        },
        "el": {
