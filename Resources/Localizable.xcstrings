    " Downloads barely moved, so the change came from what people bought.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " Les baixades gairebé no s'han mogut, així que el canvi ve del que ha comprat la gent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Downloads haben sich kaum verändert, die Veränderung kam also durch das, was gekauft wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las descargas apenas variaron, así que el cambio vino de lo que compró la gente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les téléchargements ont peu bougé : la variation vient de ce que les gens ont acheté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " I download sono rimasti quasi invariati: il cambiamento dipende da ciò che le persone hanno acquistato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Downloads veranderden nauwelijks, dus de verandering kwam door wat mensen kochten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Os downloads quase não mudaram, então a variação veio do que as pessoas compraram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Загрузки почти не изменились: изменение дали покупки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " İndirmeler neredeyse değişmedi; yani değişim insanların satın aldıklarından geldi."
          }
        }
      }
    },
