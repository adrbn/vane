    },
    "The AI command failed without saying why.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando de IA falló sin dar el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande IA a échoué sans donner de raison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando IA non è riuscito, senza indicarne il motivo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordre d'IA ha fallat sense indicar el motiu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Befehl ist ohne Angabe von Gründen fehlgeschlagen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka komutu nedenini söylemeden başarısız oldu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда ИИ завершилась с ошибкой без объяснения причины."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-opdracht is mislukt zonder reden te geven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de IA falhou sem dizer o motivo."
          }
        }
      }
    },
    "The private key couldn't be read. Paste the full contents of the AuthKey_XXXX.p8 file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave privada. Pega el contenido completo del archivo AuthKey_XXXX.p8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la clé privée. Collez le contenu complet du fichier AuthKey_XXXX.p8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la chiave privata. Incolla l’intero contenuto del file AuthKey_XXXX.p8."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir la clau privada. Enganxa el contingut complet del fitxer AuthKey_XXXX.p8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel konnte nicht gelesen werden. Fügen Sie den vollständigen Inhalt der Datei AuthKey_XXXX.p8 ein."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel anahtar okunamadı. AuthKey_XXXX.p8 dosyasının tüm içeriğini yapıştırın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать закрытый ключ. Вставьте полное содержимое файла AuthKey_XXXX.p8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De privésleutel kon niet worden gelezen. Plak de volledige inhoud van het bestand AuthKey_XXXX.p8."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a chave privada. Cole o conteúdo completo do arquivo AuthKey_XXXX.p8."
          }
        }
      }
    },
    "The same key Vane uses on the Mac": {
      "localizations": {
        "es": {
