    "Ask about the chart, table or report you're looking at. The answer comes from your own %@ account; your data goes straight from this Mac to it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre el gràfic, la taula o l'informe que estàs mirant. La resposta ve del teu propi compte de %@; les dades van directament d'aquest Mac cap allà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie zum Diagramm, zur Tabelle oder zum Bericht, den Sie gerade ansehen. Die Antwort kommt aus Ihrem eigenen %@-Account; Ihre Daten gehen direkt von diesem Mac dorthin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta sobre el gráfico, la tabla o el informe que estás viendo. La respuesta sale de tu propia cuenta de %@; tus datos van directamente de este Mac a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question sur le graphique, le tableau ou le rapport affiché. La réponse vient de votre propre compte %@ ; vos données vont directement de ce Mac vers celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda sul grafico, la tabella o il report che stai guardando. La risposta arriva dal tuo account %@; i tuoi dati vanno direttamente da questo Mac a lui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een vraag over de grafiek, tabel of het rapport dat je bekijkt. Het antwoord komt van je eigen %@-account; je gegevens gaan rechtstreeks van deze Mac ernaartoe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte sobre o gráfico, a tabela ou o relatório que você está vendo. A resposta vem da sua própria conta %@; seus dados vão direto deste Mac para ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите о графике, таблице или отчёте, которые вы смотрите. Ответ даёт ваш собственный аккаунт %@; данные передаются напрямую с этого Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baktığınız grafik, tablo veya rapor hakkında sorun. Yanıt kendi %@ hesabınızdan gelir; verileriniz bu Mac'ten doğrudan oraya gider."
          }
        }
      }
    },
