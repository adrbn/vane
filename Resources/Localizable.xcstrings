    " That is %@ ratings per 1,000 first-time downloads.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Son %@ valoraciones por cada 1000 primeras descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Soit %@ notes pour 1 000 premiers téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Sono %@ valutazioni ogni 1.000 primi download."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " Són %@ valoracions per cada 1.000 primeres baixades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Das sind %@ Bewertungen pro 1.000 Erstdownloads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Bu, her 1.000 ilk indirmede %@ puanlama demek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Это %@ оценок на 1000 первых загрузок."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Dat zijn %@ beoordelingen per 1.000 eerste downloads."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Isso dá %@ avaliações a cada 1.000 primeiros downloads."
          }
        }
      }
    },
    " With downloads nearly unchanged, the growth came from what people bought rather than from more visitors.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Con las descargas casi sin cambios, el crecimiento vino de lo que compró la gente y no de más visitantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Avec des téléchargements presque stables, la hausse vient de ce que les gens ont acheté, pas d'un surplus de visiteurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Con download quasi invariati, la crescita è dovuta a ciò che le persone hanno acquistato, non a più visitatori."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " Amb les baixades gairebé iguals, el creixement ve del que ha comprat la gent, no de més visitants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Bei fast unveränderten Downloads kam das Wachstum durch das, was gekauft wurde, und nicht durch mehr Besucher."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " İndirmeler neredeyse aynı kaldığı için büyüme, daha fazla ziyaretçiden değil insanların satın aldıklarından geldi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Загрузки почти не изменились: рост дали покупки, а не новые посетители."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Omdat downloads nauwelijks veranderden, kwam de groei door wat mensen kochten, niet door meer bezoekers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Com os downloads quase inalterados, o crescimento veio do que as pessoas compraram, e não de mais visitantes."
          }
        }
      }
    },
