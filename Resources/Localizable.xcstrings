          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε ένα κλειδί με τον ρόλο Πωλήσεις και αναφορές στο Χρήστες και πρόσβαση → Ενσωματώσεις."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“用户与访问”→“集成”中创建具有“销售和报告”角色的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「使用者與存取權」→「整合」中建立具有「銷售和報告」角色的金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザとアクセス → 統合で、「セールスおよびレポート」ロールのキーを作成します。"
          }
        },
        "ko": {
