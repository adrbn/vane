    "Vane reads your reports with an API key. The key stays in your Keychain and never leaves this Mac.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane llegeix els teus informes amb una clau d'API. La clau es queda al teu Keychain i mai surt d'aquest Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane liest Ihre Berichte mit einem API-Schlüssel. Der Schlüssel bleibt in Ihrem Schlüsselbund und verlässt diesen Mac nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane lee tus informes con una clave de API. La clave se queda en tu Llavero y nunca sale de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane lit vos rapports avec une clé API. La clé reste dans votre trousseau et ne quitte jamais ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane legge i tuoi report con una chiave API. La chiave resta nel tuo Portachiavi e non lascia mai questo Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane leest je rapporten met een API-sleutel. De sleutel blijft in je Sleutelhanger en verlaat deze Mac nooit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vane lê seus relatórios com uma chave de API. A chave fica no seu Chaveiro e nunca sai deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane читает ваши отчёты с помощью ключа API. Ключ хранится в вашей связке ключей и никогда не покидает этот Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane raporlarınızı bir API anahtarıyla okur. Anahtar Anahtar Zinciri'nizde kalır ve bu Mac'ten asla çıkmaz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane läser dina rapporter med en API-nyckel. Nyckeln stannar i din Nyckelring och lämnar aldrig den här Macen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane leser rapportene dine med en API-nøkkel. Nøkkelen blir i nøkkelringen din og forlater aldri denne Macen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane læser dine rapporter med en API-nøgle. Nøglen bliver i din Nøglering og forlader aldrig denne Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane lukee raporttisi API-avaimella. Avain pysyy Avainnipussasi eikä koskaan poistu tältä Macilta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane odczytuje Twoje raporty za pomocą klucza API. Klucz pozostaje w Pęku kluczy i nigdy nie opuszcza tego Maca."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane čte vaše přehledy pomocí klíče API. Klíč zůstává ve vaší Klíčence a nikdy neopustí tento Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane îți citește rapoartele cu o cheie API. Cheia rămâne în Breloc și nu părăsește niciodată acest Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane читає ваші звіти за допомогою ключа API. Ключ залишається у вашій Зв’язці ключів і ніколи не залишає цей Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Vane διαβάζει τις αναφορές σας με ένα κλειδί API. Το κλειδί μένει στην Αλυσίδα κλειδιών σας και δεν φεύγει ποτέ από αυτό το Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane 使用 API 密钥读取你的报告。密钥保存在你的钥匙串中，绝不会离开这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane 使用 API 金鑰讀取你的報告。金鑰儲存在你的鑰匙圈中，絕不會離開這台 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VaneはAPIキーでレポートを読み取ります。キーはキーチェーンに保存され、このMacの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane은 API 키로 보고서를 읽어요. 키는 키체인에 보관되며 이 Mac 밖으로 나가지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane อ่านรายงานของคุณด้วยคีย์ API คีย์จะอยู่ในพวงกุญแจของคุณและไม่ออกจาก Mac เครื่องนี้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vane lê os seus relatórios com uma chave API. A chave fica no seu Acesso a Porta-Chaves e nunca sai deste Mac."
          }
        }
      }
    },
