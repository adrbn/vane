          "stringUnit": {
            "state": "translated",
            "value": "Аналітика App Store з’явиться через 24–48 годин"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αναλύσεις του App Store εμφανίζονται σε 24–48 ώρες"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 分析数据将在 24–48 小时内送达"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 分析資料將在 24–48 小時內送達"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeの分析は24～48時間で届きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 분석은 24~48시간 후에 도착해요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์ App Store จะมาถึงใน 24–48 ชั่วโมง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As análises da App Store chegam em 24–48 horas"
          }
        }
      }
    },
