    "Fewer people who saw your app downloaded it. Check your screenshots, price and recent ratings.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Menys gent que ha vist la teva app l'ha baixada. Revisa les captures, el preu i les valoracions recents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Personen, die Ihre App gesehen haben, haben sie geladen. Prüfen Sie Ihre Screenshots, den Preis und die letzten Bewertungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos personas que vieron tu app la descargaron. Revisa tus capturas, el precio y las valoraciones recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de personnes ayant vu votre app l’ont téléchargée. Vérifiez vos captures, votre prix et vos notes récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno persone che hanno visto la tua app l’hanno scaricata. Controlla screenshot, prezzo e valutazioni recenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder mensen die je app zagen, downloadden die. Controleer je schermafbeeldingen, prijs en recente beoordelingen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos pessoas que viram seu app o baixaram. Verifique suas capturas de tela, preço e avaliações recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше людей, увидевших ваше приложение, загрузили его. Проверьте скриншоты, цену и недавние оценки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanızı görenlerden daha azı indirdi. Ekran görüntülerinizi, fiyatınızı ve son puanlamalarınızı kontrol edin."
          }
        }
      }
    },
    "Fewer people who saw your app tapped through to its page. Check your icon, name and first screenshots, and any Search Ads changes.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Menys gent que ha vist la teva app ha obert la seva pàgina. Revisa la icona, el nom i les primeres captures, i qualsevol canvi a Search Ads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Personen, die Ihre App gesehen haben, haben deren Seite angetippt. Prüfen Sie Ihr Symbol, den Namen, die ersten Screenshots und etwaige Änderungen bei Search Ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos personas que vieron tu app pulsaron para ir a su página. Revisa tu icono, nombre y primeras capturas, y cualquier cambio en Search Ads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de personnes ayant vu votre app ont ouvert sa page. Vérifiez votre icône, votre nom, vos premières captures d'écran et tout changement dans Search Ads."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno persone che hanno visto la tua app hanno toccato per aprirne la pagina. Controlla icona, nome e primi screenshot, e le modifiche a Search Ads."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder mensen die je app zagen, tikten door naar de pagina. Controleer je icoon, naam en eerste schermafbeeldingen, en eventuele wijzigingen in Search Ads."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos pessoas que viram seu app abriram a página dele. Verifique seu ícone, nome e primeiras capturas de tela, além de mudanças no Search Ads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше людей, увидевших ваше приложение, перешли на его страницу. Проверьте значок, название и первые скриншоты, а также изменения в Search Ads."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanızı görenlerden daha azı sayfasına dokundu. Simgenizi, adınızı, ilk ekran görüntülerinizi ve Search Ads değişikliklerini kontrol edin."
          }
        }
      }
    },
    "Fewer visitors to your product page downloaded. Check your screenshots, price and recent ratings.": {
      "extractionState": "stale",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Menys visitants de la pàgina de producte han baixat l'app. Revisa les captures, el preu i les valoracions recents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Besucher Ihrer Produktseite haben die App geladen. Prüfen Sie Ihre Screenshots, den Preis und die letzten Bewertungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos visitantes de tu página de producto la descargaron. Revisa tus capturas, precio y valoraciones recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de visiteurs de votre page produit ont téléchargé l'app. Vérifiez vos captures d'écran, votre prix et vos notes récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno visitatori della pagina prodotto hanno scaricato. Controlla screenshot, prezzo e valutazioni recenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder bezoekers van je productpagina downloadden. Controleer je schermafbeeldingen, prijs en recente beoordelingen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos visitantes da sua página de produto baixaram o app. Verifique suas capturas de tela, preço e avaliações recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньше посетителей страницы продукта загрузили приложение. Проверьте скриншоты, цену и недавние оценки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürün sayfanızı ziyaret edenlerden daha azı indirdi. Ekran görüntülerinizi, fiyatınızı ve son puanlamalarınızı kontrol edin."
          }
        }
      }
    },
