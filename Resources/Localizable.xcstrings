    "Review my App Store listing for %@. What would you change in name, subtitle and keywords to rank for more searches? Be specific.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la meva fitxa de l'App Store per a %@. Què canviaries al nom, el subtítol i les paraules clau per aparèixer en més cerques? Sigues concret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe meine App-Store-Produktseite für %@. Was würdest du an Name, Untertitel und Schlüsselwörtern ändern, um in mehr Suchen zu erscheinen? Sei konkret."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa mi ficha de App Store para %@. ¿Qué cambiarías en el nombre, el subtítulo y las palabras clave para aparecer en más búsquedas? Sé concreto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse ma fiche App Store pour %@. Que changerais-tu dans le nom, le sous-titre et les mots-clés pour apparaître dans plus de recherches ? Sois précis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza la mia scheda App Store per %@. Cosa cambieresti in nome, sottotitolo e parole chiave per comparire in più ricerche? Sii preciso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk mijn App Store-vermelding voor %@. Wat zou je veranderen aan naam, ondertitel en trefwoorden om in meer zoekopdrachten te verschijnen? Wees concreet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise minha página na App Store para %@. O que você mudaria no nome, subtítulo e palavras-chave para aparecer em mais buscas? Seja específico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверь мою страницу в App Store для %@. Что бы ты изменил в названии, подзаголовке и ключевых словах, чтобы появляться в большем числе поисков? Конкретно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için App Store sayfamı incele. Daha fazla aramada çıkmak için ad, alt başlık ve anahtar kelimelerde neyi değiştirirdin? Somut ol."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska min App Store-produktsida för %@. Vad skulle du ändra i namn, undertitel och nyckelord för att rankas på fler sökningar? Var konkret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå gjennom App Store-produktsiden min for %@. Hva ville du endret i navn, undertittel og nøkkelord for å rangere på flere søk? Vær konkret."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå min App Store-produktside for %@. Hvad ville du ændre i navn, undertitel og nøgleord for at rangere på flere søgninger? Vær konkret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioi App Store -esittelyni sovellukselle %@. Mitä muuttaisit nimessä, alaotsikossa ja avainsanoissa, jotta sijoittuisin useammissa hauissa? Ole konkreettinen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oceń mój wpis w App Store dla %@. Co zmieniłbyś w nazwie, podtytule i słowach kluczowych, aby pozycjonować się na więcej fraz? Bądź konkretny."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhodnoť můj záznam v App Storu pro %@. Co bys změnil v názvu, podtitulu a klíčových slovech, aby se aplikace umístila ve více hledáních? Buď konkrétní."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizează pagina mea din App Store pentru %@. Ce ai schimba la nume, subtitlu și cuvinte-cheie pentru a te clasa la mai multe căutări? Fii concret."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проаналізуй мою картку в App Store для %@. Що б ти змінив у назві, підзаголовку й ключових словах, щоб ранжуватися за більшою кількістю запитів? Конкретно."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξέτασε τη σελίδα μου στο App Store για το %@. Τι θα άλλαζες στο όνομα, τον υπότιτλο και τις λέξεις-κλειδιά για να κατατάσσομαι σε περισσότερες αναζητήσεις; Να είσαι συγκεκριμένος."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查我为 %@ 设置的 App Store 商店信息。为了在更多搜索中获得排名，你会如何修改名称、副标题和关键词？请具体说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查我為 %@ 設定的 App Store 商店資訊。為了在更多搜尋中獲得排名，你會如何修改名稱、副標題和關鍵字？請具體說明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のApp Store掲載情報をレビューしてください。より多くの検索で上位に表示されるために、名前、サブタイトル、キーワードをどう変更しますか？具体的に教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 App Store 앱 정보를 검토해 줘. 더 많은 검색에서 순위를 얻으려면 이름, 부제목, 키워드를 어떻게 바꾸겠어? 구체적으로 알려 줘."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบรายการแอป App Store ของ %@ คุณจะเปลี่ยนอะไรในชื่อ คำบรรยายย่อย และคีย์เวิร์ดเพื่อให้ติดอันดับการค้นหามากขึ้น ขอแบบเจาะจง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisa a minha ficha da App Store de %@. O que mudarias no nome, no subtítulo e nas palavras-chave para aparecer em mais pesquisas? Sê específico."
          }
        }
      }
    },
