    "%@ ratings per 1,000 downloads since this release, down from %@. Check whether your rating prompt changed.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ valoracions per cada 1.000 baixades des d'aquesta versió, abans %2$@. Comprova si ha canviat la sol·licitud de valoració."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Bewertungen pro 1.000 Downloads seit diesem Release, zuvor %2$@. Prüfen Sie, ob sich Ihre Bewertungsaufforderung geändert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ ratings per 1,000 downloads since this release, down from %2$@. Check whether your rating prompt changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ valoraciones por cada 1000 descargas desde esta versión, frente a %@. Comprueba si ha cambiado tu solicitud de valoración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ notes pour 1 000 téléchargements depuis cette version, contre %@ avant. Vérifiez si votre demande de note a changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ valutazioni ogni 1.000 download da questa versione, in calo rispetto a %@. Controlla se hai cambiato la richiesta di valutazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beoordelingen per 1.000 downloads sinds deze release, eerder %2$@. Controleer of je beoordelingsverzoek is veranderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avaliações por 1.000 downloads desde esta versão, ante %2$@. Verifique se o pedido de avaliação mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ оценок на 1000 загрузок с момента этого релиза, раньше было %2$@. Проверьте, не изменился ли запрос оценки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümden beri her 1.000 indirmede %1$@ puanlama; önceden %2$@ idi. Puanlama isteminizin değişip değişmediğini kontrol edin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ betyg per 1 000 nedladdningar sedan den här versionen, ner från %2$@. Kontrollera om din betygsuppmaning har ändrats."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vurderinger per 1000 nedlastinger siden denne versjonen, ned fra %2$@. Sjekk om vurderingsforespørselen din er endret."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vurderinger pr. 1.000 downloads siden denne version, ned fra %2$@. Tjek, om din vurderingsanmodning er ændret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ arvosanaa tuhatta latausta kohden tämän julkaisun jälkeen, aiemmin %2$@. Tarkista, onko arvosanapyyntösi muuttunut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ocen na 1 000 pobrań od tego wydania, wcześniej %2$@. Sprawdź, czy zmieniła się prośba o ocenę."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hodnocení na 1 000 stažení od tohoto vydání, dříve %2$@. Zkontrolujte, zda se nezměnila výzva k hodnocení."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ evaluări la 1.000 de descărcări de la această versiune, față de %2$@. Verifică dacă s-a schimbat solicitarea de evaluare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ оцінок на 1000 завантажень із цього випуску, було %2$@. Перевірте, чи не змінився запит на оцінку."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ βαθμολογίες ανά 1.000 λήψεις από αυτήν την έκδοση, από %2$@. Ελέγξτε αν άλλαξε το μήνυμα αξιολόγησης."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自此版本发布以来，每 1,000 次下载有 %1$@ 个评分，此前为 %2$@。请检查评分提示是否有变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自此版本發布以來，每 1,000 次下載有 %1$@ 個評分，此前為 %2$@。請檢查評分提示是否有變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリリース以降、1,000ダウンロードあたりの評価は%1$@件で、以前の%2$@件から減少しています。評価のプロンプトが変わっていないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 릴리스 이후 다운로드 1,000건당 평점 %1$@개로, 이전 %2$@개에서 줄었어요. 평점 요청 화면이 바뀌었는지 확인해 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การให้คะแนน %1$@ ครั้งต่อการดาวน์โหลด 1,000 ครั้งนับจากรุ่นนี้ ลดลงจาก %2$@ ลองตรวจสอบว่าข้อความขอคะแนนของคุณเปลี่ยนไปหรือไม่"
          }
        },
        "pt-PT": {
