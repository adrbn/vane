    "Your first App Store report arrives in 24–48 hours": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer informe de l'App Store arriba en 24–48 hores"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr erster App Store-Bericht kommt in 24–48 Stunden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu primer informe del App Store llega en 24–48 horas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre premier rapport App Store arrive sous 24 à 48 heures"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo primo report dell’App Store arriva in 24–48 ore"
          }
        },
        "nl": {
