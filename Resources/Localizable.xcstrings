    "Three made-up apps. Your own data isn't touched.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres apps inventades. Les teves dades no es toquen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei erfundene Apps. Ihre eigenen Daten bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres apps inventadas. Tus datos no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois apps fictives. Vos données ne sont pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre app inventate. I tuoi dati non vengono toccati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drie verzonnen apps. Je eigen gegevens blijven onaangeroerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Três apps fictícios. Seus próprios dados não são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три вымышленных приложения. Ваши данные не затрагиваются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç uydurma uygulama. Kendi verilerinize dokunulmaz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre påhittade appar. Dina egna data berörs inte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre oppdiktede apper. Dine egne data berøres ikke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tre opdigtede apps. Dine egne data berøres ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolme keksittyä sovellusta. Omiin tietoihisi ei kosketa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzy zmyślone aplikacje. Twoje dane pozostają nietknięte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tři vymyšlené aplikace. Vaše vlastní data zůstávají nedotčena."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trei aplicații inventate. Datele tale nu sunt atinse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Три вигадані застосунки. Ваші дані не зачіпаються."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τρεις φανταστικές εφαρμογές. Τα δικά σας δεδομένα δεν επηρεάζονται."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三个虚构的 App。你自己的数据不会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "三個虛構的 App。你自己的資料不會受到影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "架空のApp 3つ。ご自身のデータには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상의 앱 3개예요. 내 데이터는 변경되지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปสมมติสามแอป ข้อมูลจริงของคุณไม่ถูกแตะต้อง"
          }
        },
        "pt-PT": {
