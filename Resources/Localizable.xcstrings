    "Couldn't find the %@ command. Install it and sign in, then try again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat l'ordre %@. Instal·la-la, inicia la sessió i torna-ho a provar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl %@ wurde nicht gefunden. Installieren Sie ihn, melden Sie sich an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra el comando %@. Instálalo, inicia sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande %@ introuvable. Installez-la et connectez-vous, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare il comando %@. Installalo ed effettua l’accesso, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon de opdracht %@ niet vinden. Installeer die, log in en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar o comando %@. Instale-o, faça login e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти команду %@. Установите её, войдите в систему и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ komutu bulunamadı. Kurup oturum açın, sonra tekrar deneyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittade inte kommandot %@. Installera det och logga in och försök sedan igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke kommandoen %@. Installer den og logg inn, og prøv igjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke finde kommandoen %@. Installer den og log ind, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentoa %@ ei löytynyt. Asenna se ja kirjaudu sisään, yritä sitten uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono polecenia %@. Zainstaluj je i zaloguj się, a następnie spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příkaz %@ se nenašel. Nainstalujte ho, přihlaste se a zkuste to znovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am găsit comanda %@. Instaleaz-o și autentifică-te, apoi încearcă din nou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося знайти команду %@. Установіть її, увійдіть і повторіть спробу."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε η εντολή %@. Εγκαταστήστε την, συνδεθείτε και δοκιμάστε ξανά."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@ 命令。请先安装并登录，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 %@ 指令。請先安裝並登入，然後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@コマンドが見つかりません。インストールしてサインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 명령을 찾을 수 없어요. 설치하고 로그인한 다음 다시 시도하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
