    "Tap Scan the Code on Your Mac, or point the Camera here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escaneja el codi del teu Mac o apunta la càmera aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Code auf Ihrem Mac scannen“ oder richten Sie die Kamera hierher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escanear el código en tu Mac o apunta la cámara aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Scanner le code sur votre Mac, ou pointez l'appareil photo ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Inquadra il codice sul tuo Mac, oppure punta la Fotocamera qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Scan de code op je Mac, of richt de camera hierop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Leia o código no seu Mac ou aponte a Câmera para cá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Отсканировать код на Mac» или наведите камеру сюда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizdeki Kodu Tarayın'a dokunun veya Kamera'yı buraya doğrultun."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Skanna koden på din Mac, eller rikta kameran hit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Skann koden på Macen din, eller pek kameraet hit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Scan koden på din Mac, eller ret kameraet herhen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Skannaa koodi Macilta tai osoita Kameralla tähän."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Zeskanuj kod na Macu lub skieruj tutaj aparat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na Naskenovat kód na Macu, nebo sem namiřte fotoaparát."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge Scanează codul de pe Mac sau îndreaptă camera aici."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться «Сканувати код на Mac» або наведіть камеру сюди."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε Σάρωση κωδικού στο Mac σας ή στρέψτε εδώ την Κάμερα."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“扫描 Mac 上的二维码”，或将相机对准这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「掃描 Mac 上的QR 碼」，或將相機對準這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Mac上のコードをスキャン」をタップするか、ここにカメラを向けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 코드 스캔을 탭하거나 카메라를 여기에 향하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะสแกนรหัสบน Mac ของคุณ หรือเล็งกล้องมาที่นี่"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Ler o código no seu Mac ou aponte a Câmara para aqui."
          }
        }
      }
    },
