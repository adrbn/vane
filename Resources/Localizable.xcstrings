    "Sales reports go back a year, so these were imported right away": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els informes de vendes arriben fins a un any enrere, així que s'han importat de seguida"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkaufsberichte reichen ein Jahr zurück, daher wurden diese sofort importiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de ventas se remontan un año, así que se importaron enseguida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports de ventes remontent à un an : ils ont été importés tout de suite"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I report di vendita risalgono a un anno fa, quindi sono stati importati subito"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verkooprapporten gaan een jaar terug, dus deze zijn meteen geïmporteerd"
          }
        },
        "pt": {
