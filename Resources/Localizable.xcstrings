            "value": "Claude Code non ha effettuato l’accesso. Esegui claude /login nel Terminale, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is uitgelogd. Voer claude /login uit in Terminal en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code está desconectado. Execute claude /login no Terminal e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнен выход из Claude Code. Выполните claude /login в Терминале и повторите попытку."
