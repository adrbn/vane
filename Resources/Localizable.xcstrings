    "In 1 to 2 days. Impressions, page views, conversion and sessions, as Apple publishes each report.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En 1 o 2 dies. Impressions, visualitzacions de pàgina, conversió i sessions, a mesura que Apple publica cada informe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In 1 bis 2 Tagen. Impressionen, Seitenaufrufe, Conversion und Sitzungen, sobald Apple den jeweiligen Bericht veröffentlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En 1 o 2 días. Impresiones, visualizaciones de la página, conversión y sesiones, según Apple publica cada informe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous 1 à 2 jours. Impressions, vues de page, conversion et sessions, à mesure qu'Apple publie chaque rapport."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra 1 e 2 giorni. Impressioni, visualizzazioni della pagina, conversione e sessioni, man mano che Apple pubblica ogni report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Over 1 tot 2 dagen. Vertoningen, paginaweergaven, conversie en sessies, zodra Apple elk rapport publiceert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Em 1 a 2 dias. Impressões, visualizações da página, conversão e sessões, conforme a Apple publica cada relatório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через 1–2 дня. Показы, просмотры страницы, конверсия и сеансы по мере публикации каждого отчёта Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ila 2 gün içinde. Apple her raporu yayınladıkça gösterimler, sayfa görüntülemeleri, dönüşüm ve oturumlar."
          }
        }
      }
    },
    "In App Store Connect: Users and Access → Integrations → App Store Connect API. The key needs the Sales and Reports role.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store Connect: Usuaris i accés → Integracions → API d'App Store Connect. La clau necessita el rol Vendes i informes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In App Store Connect: Benutzer und Zugriff → Integrationen → App Store Connect API. Der Schlüssel benötigt die Rolle „Vertrieb und Berichte“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En App Store Connect: Usuarios y acceso → Integraciones → API de App Store Connect. La clave necesita el rol Ventas e informes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans App Store Connect : Utilisateurs et accès → Intégrations → API App Store Connect. La clé doit avoir le rôle Ventes et rapports."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In App Store Connect: Utenti e accesso → Integrazioni → API App Store Connect. La chiave richiede il ruolo Vendite e report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In App Store Connect: Gebruikers en toegang → Integraties → App Store Connect API. De sleutel heeft de rol Verkoop en rapporten nodig."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No App Store Connect: Usuários e Acesso → Integrações → API do App Store Connect. A chave precisa da função Vendas e Relatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В App Store Connect: «Пользователи и доступ» → «Интеграции» → API App Store Connect. Ключу нужна роль «Продажи и отчёты»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect'te: Kullanıcılar ve Erişim → Entegrasyonlar → App Store Connect API. Anahtarın Satışlar ve Raporlar rolüne sahip olması gerekir."
          }
        }
      }
    },
