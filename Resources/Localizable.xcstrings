    "Free and open source under the MIT license. Made by adrbn.\nNot affiliated with Apple.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuïta i de codi obert amb llicència MIT. Feta per adrbn.\nNo afiliada a Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos und Open Source unter der MIT-Lizenz. Entwickelt von adrbn.\nNicht mit Apple verbunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis y de código abierto con licencia MIT. Hecho por adrbn.\nNo está afiliado a Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit et open source sous licence MIT. Créé par adrbn.\nSans lien avec Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuita e open source con licenza MIT. Realizzata da adrbn.\nNon affiliata ad Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en open source onder de MIT-licentie. Gemaakt door adrbn.\nNiet verbonden aan Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuito e de código aberto sob a licença MIT. Feito por adrbn.\nSem afiliação com a Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно и с открытым исходным кодом по лицензии MIT. Автор: adrbn.\nНе связано с Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT lisansı altında ücretsiz ve açık kaynak. adrbn tarafından yapıldı.\nApple ile bağlantısı yoktur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis och öppen källkod under MIT-licensen. Skapad av adrbn.\nInte kopplad till Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis og åpen kildekode under MIT-lisensen. Laget av adrbn.\nIkke tilknyttet Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis og open source under MIT-licensen. Lavet af adrbn.\nIkke tilknyttet Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmainen ja avoimen lähdekoodin MIT-lisenssillä. Tekijä: adrbn.\nEi ole sidoksissa Appleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatna i open source na licencji MIT. Stworzył adrbn.\nNie jest powiązana z Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma a open source pod licencí MIT. Vytvořil adrbn.\nNení spojeno s Applem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuită și open source, sub licența MIT. Creată de adrbn.\nNeafiliată cu Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно та з відкритим кодом за ліцензією MIT. Створив adrbn.\nНе пов’язано з Apple."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δωρεάν και ανοιχτού κώδικα με άδεια MIT. Δημιουργία: adrbn.\nΔεν σχετίζεται με την Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 MIT 许可证的免费开源软件。由 adrbn 制作。\n与 Apple 无关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基於 MIT 許可證的免費開源軟體。由 adrbn 製作。\n與 Apple 無關聯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MITライセンスの無料オープンソースです。作者: adrbn。\nAppleとは無関係です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MIT 라이선스의 무료 오픈 소스예요. 제작: adrbn.\nApple과 관련이 없어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟรีและโอเพนซอร์สภายใต้สัญญาอนุญาต MIT สร้างโดย adrbn\nไม่เกี่ยวข้องกับ Apple"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuita e de código aberto sob a licença MIT. Feita por adrbn.\nSem afiliação à Apple."
          }
        }
      }
    },
