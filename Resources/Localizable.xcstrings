    " Downloads barely moved, so the change came from what people bought.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": " Les baixades gairebé no s'han mogut, així que el canvi ve del que ha comprat la gent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Die Downloads haben sich kaum verändert, die Veränderung kam also durch das, was gekauft wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las descargas apenas variaron, así que el cambio vino de lo que compró la gente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les téléchargements ont peu bougé : la variation vient de ce que les gens ont acheté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " I download sono rimasti quasi invariati: il cambiamento dipende da ciò che le persone hanno acquistato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": " Downloads veranderden nauwelijks, dus de verandering kwam door wat mensen kochten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": " Os downloads quase não mudaram, então a variação veio do que as pessoas compraram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Загрузки почти не изменились: изменение дали покупки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " İndirmeler neredeyse değişmedi; yani değişim insanların satın aldıklarından geldi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": " Nedladdningarna ändrades knappt, så förändringen kom från vad folk köpte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": " Nedlastingene endret seg knapt, så endringen kom fra det folk kjøpte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": " Downloads ændrede sig næsten ikke, så ændringen kom fra det, folk købte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": " Lataukset eivät juuri muuttuneet, joten muutos johtui siitä, mitä ihmiset ostivat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": " Pobrania prawie się nie zmieniły, więc zmiana wynikała z tego, co ludzie kupowali."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": " Stažení se téměř nezměnila, takže změna vzešla z toho, co lidé nakupovali."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Descărcările abia s-au schimbat, deci schimbarea a venit din ce au cumpărat oamenii."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": " Завантажень майже не змінилося, тож зміна пов’язана з покупками."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": " Οι λήψεις σχεδόν δεν άλλαξαν, άρα η αλλαγή προήλθε από όσα αγόρασαν οι χρήστες."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载量变化不大，变化主要来自用户的购买内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載量變化不大，變化主要來自使用者的購買內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード数はほとんど変わらず、変化は購入内容によるものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 다운로드는 거의 변하지 않았으므로, 변화는 사람들이 구매한 항목에서 나왔어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": " ยอดดาวน์โหลดแทบไม่เปลี่ยน การเปลี่ยนแปลงจึงมาจากสิ่งที่ผู้คนซื้อ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " As transferências quase não mudaram, por isso a variação veio do que as pessoas compraram."
          }
        }
      }
    },
