            "value": "Bu sürümden beri her 1.000 indirmede %1$@ puanlama; önceden %2$@ idi. Puanlama isteminizin değişip değişmediğini kontrol edin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ оценок на 1000 загрузок с момента этого релиза, раньше было %2$@. Проверьте, не изменился ли запрос оценки."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beoordelingen per 1.000 downloads sinds deze release, eerder %2$@. Controleer of je beoordelingsverzoek is veranderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avaliações por 1.000 downloads desde esta versão, ante %2$@. Verifique se o pedido de avaliação mudou."
          }
        }
      }
    },
    "%@ returned nothing. Run `%@` once in Terminal to check you're signed in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ returned nothing. Run `%2$@` once in Terminal to check you're signed in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no devolvió nada. Ejecuta `%@` una vez en Terminal para comprobar que has iniciado sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a rien renvoyé. Exécutez `%@` une fois dans Terminal pour vérifier que vous êtes connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha restituito nulla. Esegui `%@` una volta nel Terminale per verificare di aver effettuato l’accesso."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no ha retornat res. Executa `%2$@` una vegada al Terminal per comprovar que has iniciat la sessió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat nichts zurückgegeben. Führen Sie `%2$@` einmal im Terminal aus, um zu prüfen, ob Sie angemeldet sind."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hiçbir şey döndürmedi. Oturum açtığınızı doğrulamak için Terminal'de bir kez `%2$@` çalıştırın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда %1$@ ничего не вернула. Выполните `%2$@` один раз в Терминале, чтобы убедиться, что вы вошли в систему."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gaf niets terug. Voer `%2$@` eenmaal uit in Terminal om te controleren of je bent ingelogd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não retornou nada. Execute `%2$@` uma vez no Terminal para confirmar que você está conectado."
          }
        }
      }
    },
    "%@ uses %lld of 100 characters. Every free character is a search term you aren't ranking for.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ uses %2$lld of 100 characters. Every free character is a search term you aren't ranking for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa %lld de 100 caracteres. Cada carácter libre es un término de búsqueda en el que no te posicionas."
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ utilise %lld caractère sur 100. Chaque caractère libre est un terme de recherche sur lequel vous n'êtes pas classé."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ utilise %lld caractères sur 100. Chaque caractère libre est un terme de recherche sur lequel vous n'êtes pas classé."
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa %lld caratteri su 100. Ogni carattere libero è un termine di ricerca per cui non ti posizioni."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fa servir %2$lld de 100 caràcters. Cada caràcter lliure és un terme de cerca pel qual no et posiciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ nutzt %2$lld von 100 Zeichen. Jedes freie Zeichen ist ein Suchbegriff, für den Sie nicht ranken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 100 karakterin %2$lld tanesini kullanıyor. Boş kalan her karakter, sıralanmadığınız bir arama terimidir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ использует %2$lld из 100 символов. Каждый свободный символ — это поисковый запрос, по которому вы не ранжируетесь."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gebruikt %2$lld van de 100 tekens. Elk vrij teken is een zoekterm waarop je niet scoort."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ usa %2$lld de 100 caracteres. Cada caractere livre é um termo de busca pelo qual você não está ranqueando."
          }
        }
      }
    },
