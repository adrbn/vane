    "Usage comes from Apple's analytics report, one or two days after the first install.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ús ve de l'informe d'analítica d'Apple, un o dos dies després de la primera instal·lació."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung stammt aus dem Analytics-Bericht von Apple, ein bis zwei Tage nach der ersten Installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso sale del informe de analíticas de Apple, uno o dos días después de la primera instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'utilisation vient du rapport d'analyse d'Apple, un ou deux jours après la première installation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilizzo proviene dal report di analisi di Apple, uno o due giorni dopo la prima installazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik komt uit Apples analyserapport, een of twee dagen na de eerste installatie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O uso vem do relatório de análises da Apple, um ou dois dias após a primeira instalação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные об использовании берутся из аналитического отчёта Apple через один–два дня после первой установки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım, Apple'ın analiz raporundan gelir; ilk kurulumdan bir iki gün sonra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användningen kommer från Apples analysrapport, en till två dagar efter den första installationen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruksdata kommer fra Apples analyserapport, én til to dager etter første installasjon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brugsdata kommer fra Apples analyserapport, en til to dage efter den første installation."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttötiedot tulevat Applen analytiikkaraportista, yhdestä kahteen päivää ensimmäisen asennuksen jälkeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użycie pochodzi z raportu analitycznego Apple, jeden do dwóch dni po pierwszej instalacji."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Využití pochází z analytického přehledu Applu, jeden až dva dny po první instalaci."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizarea vine din raportul de analiză Apple, la una-două zile după prima instalare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використання береться зі звіту аналітики Apple через один-два дні після першого встановлення."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η χρήση προέρχεται από την αναφορά αναλύσεων της Apple, μία ή δύο ημέρες μετά την πρώτη εγκατάσταση."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用情况来自 Apple 的分析报告，在首次安装后一到两天提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用情況來自 Apple 的分析報告，在首次安裝後一到兩天提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用状況はAppleの分析レポートから取得され、最初のインストールの1～2日後に届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량은 첫 설치 1~2일 후에 Apple의 분석 보고서에서 가져와요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การใช้งานมาจากรายงานการวิเคราะห์ของ Apple หนึ่งหรือสองวันหลังการติดตั้งครั้งแรก"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A utilização vem do relatório de análises da Apple, um ou dois dias após a primeira instalação."
          }
        }
      }
    },
