    "Now. Downloads, proceeds and territories, as far back as Apple keeps them.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara. Baixades, ingressos i territoris, tan enrere com Apple els conserva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt. Downloads, Einnahmen und Länder oder Regionen, so weit zurück, wie Apple sie vorhält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora. Descargas, ingresos netos y territorios, desde donde Apple los conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout de suite. Téléchargements, produits et territoires, aussi loin qu'Apple les conserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora. Download, ricavi e territori, fin dove Apple li conserva."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu. Downloads, opbrengst en regio's, zo ver terug als Apple ze bewaart."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora. Downloads, receita líquida e territórios, até onde a Apple mantém o histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас. Загрузки, доход и регионы за весь срок, который хранит Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi. İndirmeler, kazançlar ve bölgeler, Apple'ın tuttuğu en eski tarihe kadar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu. Nedladdningar, intäkter och områden, så långt tillbaka som Apple sparar dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå. Nedlastinger, inntekter og områder, så langt tilbake som Apple beholder dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu. Downloads, indtægter og områder, så langt tilbage som Apple gemmer dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt. Lataukset, tuotot ja alueet niin kauas taaksepäin kuin Apple niitä säilyttää."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz. Pobrania, wpływy i terytoria, tak daleko wstecz, jak Apple je przechowuje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní. Stažení, výdělky a území, tak daleko do minulosti, jak je Apple uchovává."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum. Descărcări, încasări și teritorii, atât de departe cât le păstrează Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз. Завантаження, надходження та території — настільки давні, наскільки їх зберігає Apple."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα. Λήψεις, έσοδα και περιοχές, όσο πίσω κρατά η Apple τα δεδομένα."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在。下载量、收益和国家或地区数据，Apple 保留多久就回溯多久。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在。下載量、收益和國家或地區資料，Apple 保留多久就回溯多久。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ。ダウンロード、収益、国と地域が、Appleが保持している範囲までさかのぼって表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금. Apple이 보관하는 기간만큼의 다운로드, 수익, 국가 및 지역이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ การดาวน์โหลด รายได้ และประเทศหรือภูมิภาค ย้อนหลังเท่าที่ Apple เก็บไว้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora. Transferências, receitas e países ou regiões, até onde a Apple os guarda."
          }
        }
      }
    },
    "Of every 1,000 people who saw %@, %@ opened its page and %@ downloaded it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1.000 persones que han vist %1$@, %2$@ n'han obert la pàgina i %3$@ l'han baixada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von je 1.000 Personen, die %1$@ gesehen haben, haben %2$@ die Seite geöffnet und %3$@ die App geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Of every 1,000 people who saw %1$@, %2$@ opened its page and %3$@ downloaded it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1000 personas que vieron %@, %@ abrieron su página y %@ la descargaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 1 000 personnes qui ont vu %@, %@ ont ouvert sa page et %@ l'ont téléchargée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 1.000 persone che hanno visto %@, %@ hanno aperto la pagina e %@ l’hanno scaricata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van elke 1.000 mensen die %1$@ zagen, openden %2$@ de pagina en downloadden %3$@ de app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1.000 pessoas que viram %1$@, %2$@ abriram a página e %3$@ baixaram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из каждой 1000 человек, увидевших %1$@, страницу открыли %2$@ и загрузили %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uygulamasını gören her 1.000 kişiden %2$@ sayfasını açtı ve %3$@ indirdi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av 1 000 personer som såg %1$@ öppnade %2$@ dess sida och %3$@ laddade ner den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av hver 1000 som så %1$@, åpnet %2$@ siden, og %3$@ lastet den ned."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Af hver 1.000 personer, der så %1$@, åbnede %2$@ dens side, og %3$@ downloadede den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuhannesta %1$@ nähneestä %2$@ avasi sen sivun ja %3$@ latasi sen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na każde 1000 osób, które zobaczyły %1$@, %2$@ otworzyło jej stronę, a %3$@ ją pobrało."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z každých 1 000 lidí, kteří viděli %1$@, jich %2$@ otevřelo jeho stránku a %3$@ si ho stáhlo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din fiecare 1.000 de persoane care au văzut %1$@, %2$@ au deschis pagina și %3$@ l-au descărcat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З кожної 1000 людей, які побачили %1$@, %2$@ відкрили його сторінку, а %3$@ завантажили."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από κάθε 1.000 άτομα που είδαν το %1$@, %2$@ άνοιξαν τη σελίδα του και %3$@ το κατέβασαν."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每 1,000 位看到 %1$@ 的人中，有 %2$@ 位打开了其页面，%3$@ 位下载了它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每 1,000 位看到 %1$@ 的人中，有 %2$@ 位開啟了其頁面，%3$@ 位下載了它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を見た1,000人のうち、%2$@人がページを開き、%3$@人がダウンロードしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 본 1,000명 중 %2$@명이 페이지를 열었고 %3$@명이 다운로드했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากทุก 1,000 คนที่เห็น %1$@ มี %2$@ คนเปิดหน้าแอปและ %3$@ คนดาวน์โหลด"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1000 pessoas que viram %1$@, %2$@ abriram a página e %3$@ transferiram-na."
          }
        }
      }
    },
