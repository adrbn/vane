    "You got %@ downloads on %@, more than any day since %@.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has tingut %1$@ baixades el %2$@, més que cap dia des de %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hatten am %2$@ %1$@ Downloads, mehr als an jedem Tag seit %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You got %1$@ downloads on %2$@, more than any day since %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseguiste %@ descargas el %@, más que cualquier día desde el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ téléchargements le %@, plus que n'importe quel jour depuis le %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ottenuto %@ download il %@, più di qualsiasi giorno dal %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kreeg %1$@ downloads op %2$@, meer dan op enige dag sinds %3$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você teve %1$@ downloads em %2$@, mais que em qualquer dia desde %3$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас %1$@ загрузок %2$@ — больше, чем в любой день с %3$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ tarihinde %1$@ indirme aldınız; bu, %3$@ tarihinden beri her günden fazla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fick %1$@ nedladdningar den %2$@, fler än någon dag sedan %3$@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fikk %1$@ nedlastinger den %2$@, flere enn noen dag siden %3$@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du fik %1$@ downloads den %2$@, flere end nogen dag siden %3$@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sait %1$@ latausta %2$@, enemmän kuin yhtenäkään päivänä %3$@ jälkeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz %1$@ pobrań %2$@, więcej niż w jakimkolwiek dniu od %3$@."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostali jste %1$@ stažení %2$@, více než kterýkoli den od %3$@."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai avut %1$@ descărcări pe %2$@, mai multe decât în orice zi de la %3$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас %1$@ завантажень %2$@, більше, ніж у будь-який день з %3$@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είχατε %1$@ λήψεις στις %2$@, περισσότερες από οποιαδήποτε ημέρα από τις %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %2$@ 获得了 %1$@ 次下载，是自 %3$@ 以来最多的一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 %2$@ 獲得了 %1$@ 次下載，是自 %3$@ 以來最多的一天。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@に%1$@件のダウンロードがあり、%3$@以降で最多の日となりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에 다운로드 %1$@건을 기록했고, %3$@ 이후 어느 날보다 많아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้รับการดาวน์โหลด %1$@ ครั้งเมื่อ %2$@ มากกว่าทุกวันตั้งแต่ %3$@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Teve %1$@ transferências em %2$@, mais do que em qualquer dia desde %3$@."
          }
        }
      }
    },
