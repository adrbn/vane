        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำบรรยายย่อยถูกจัดทำดัชนีสำหรับการค้นหาและแสดงใต้ชื่อของคุณ ยังมี 30 อักขระที่ไม่ได้ใช้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O subtítulo é indexado para pesquisa e mostrado por baixo do nome. Há 30 carateres livres por usar."
          }
        }
      }
    },
    "This %@ isn't fully covered by the sales reports yet": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest %@ encara no està del tot cobert pels informes de vendes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitraum (%@) ist von den Verkaufsberichten noch nicht vollständig abgedeckt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de ventas aún no cubren por completo el periodo (%@ actual)"
