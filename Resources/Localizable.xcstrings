    "Each app has its own App Store page. Numbers, reviews and insights can be seen together; the listing can't.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada app té la seva pàgina a l'App Store. Les xifres, ressenyes i observacions es poden veure juntes; la fitxa, no."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede App hat ihre eigene App-Store-Seite. Zahlen, Bewertungen und Einblicke lassen sich zusammen ansehen, der Eintrag nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada app tiene su propia página en el App Store. Las cifras, reseñas y observaciones se pueden ver juntas; la ficha, no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque app a sa propre page App Store. Chiffres, avis et analyses se voient ensemble ; la fiche, non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni app ha la sua pagina sull'App Store. Numeri, recensioni e approfondimenti si vedono insieme; la scheda no."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke app heeft zijn eigen App Store-pagina. Cijfers, recensies en inzichten kun je samen bekijken, de vermelding niet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada app tem a sua página na App Store. Números, avaliações e análises podem ser vistos em conjunto; a ficha não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого приложения своя страница в App Store. Цифры, отзывы и наблюдения можно смотреть вместе, а карточку — нет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her uygulamanın kendi App Store sayfası vardır. Sayılar, yorumlar ve öngörüler birlikte görülebilir; sayfa bilgileri görülemez."
          }
        }
      }
    },
