            "state": "translated",
            "value": "Первый отчёт App Store придёт через 24–48 часов"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk App Store raporunuz 24–48 saat içinde gelir"
          }
        },
        "sv": {
