    "“%@” already count from the name or subtitle. The space is better used for new words.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ja compten des del nom o el subtítol. És millor aprofitar l'espai per a paraules noves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ zählen bereits aus dem Namen oder Untertitel. Der Platz wird besser für neue Wörter genutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya cuentan desde el nombre o subtítulo. El espacio se aprovecha mejor con palabras nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » comptent déjà grâce au nom ou au sous-titre. Mieux vaut utiliser cet espace pour de nouveaux mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” già contano dal nome o dal sottotitolo. Lo spazio è meglio usato per parole nuove."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tellen al mee vanuit de naam of ondertitel. De ruimte kun je beter voor nieuwe woorden gebruiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já contam pelo nome ou subtítulo. O espaço rende mais com palavras novas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже учитываются из названия или подзаголовка. Это место лучше занять новыми словами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” zaten ad veya alt başlıktan sayılıyor. Alan yeni kelimeler için daha iyi kullanılır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” räknas redan från namnet eller undertiteln. Utrymmet används bättre till nya ord."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» teller allerede fra navnet eller undertittelen. Plassen brukes bedre til nye ord."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« tæller allerede fra navnet eller undertitlen. Pladsen bruges bedre til nye ord."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” lasketaan jo nimestä tai alaotsikosta. Tila kannattaa käyttää uusiin sanoihin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” są już liczone z nazwy lub podtytułu. Lepiej wykorzystać to miejsce na nowe słowa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ se už počítají z názvu nebo podtitulu. Místo je lepší využít na nová slova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” sunt deja luate în calcul din nume sau subtitlu. Spațiul e mai bine folosit pentru cuvinte noi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» уже враховано з назви чи підзаголовка. Краще використати місце для нових слів."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το «%@» προσμετράται ήδη από το όνομα ή τον υπότιτλο. Ο χώρος αξιοποιείται καλύτερα για νέες λέξεις."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已计入名称或副标题。这些空间更适合用来放新词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已計入名稱或副標題。這些空間更適合用來放新詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は名前またはサブタイトルからすでに反映されています。そのスペースは新しい語に使うほうが効果的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 이미 이름이나 부제목으로 집계돼요. 그 공간은 새 단어에 쓰는 편이 좋아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” นับจากชื่อหรือคำบรรยายย่อยอยู่แล้ว ควรใช้ที่ว่างนี้กับคำใหม่"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já contam a partir do nome ou do subtítulo. O espaço é melhor aproveitado com palavras novas."
          }
        }
      }
    },
