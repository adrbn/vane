            "state": "translated",
            "value": "Affiche un code QR que l'appareil photo de l'iPhone peut scanner pour se connecter avec cette clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un codice QR che la Fotocamera dell’iPhone può inquadrare per connettersi con questa chiave."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont een QR-code die de camera van de iPhone kan scannen om met deze sleutel te verbinden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um código QR que a Câmera do iPhone pode ler para conectar com esta chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает QR-код, который можно отсканировать камерой iPhone, чтобы подключиться с этим ключом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Kamerası'nın bu anahtarla bağlanmak için tarayabileceği bir QR kodu gösterir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar en QR-kod som iPhones kamera kan skanna för att ansluta med den här nyckeln."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en QR-kode som kameraet på iPhone kan skanne for å koble til med denne nøkkelen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en QR-kode, som kameraet på iPhone kan scanne for at tilslutte med denne nøgle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää QR-koodin, jonka iPhonen Kamera voi skannata yhdistääkseen tällä avaimella."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje kod QR, który aparat iPhone'a może zeskanować, aby połączyć się tym kluczem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí QR kód, který může fotoaparát iPhonu naskenovat a připojit se tímto klíčem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează un cod QR pe care îl poate scana camera iPhone-ului pentru a se conecta cu această cheie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує QR-код, який може просканувати камера iPhone, щоб підключитися з цим ключем."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει έναν κωδικό QR που μπορεί να σαρώσει η Κάμερα του iPhone για σύνδεση με αυτό το κλειδί."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示一个二维码，iPhone 的“相机”可扫描它并使用此密钥连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示一個QR 碼，iPhone 的「相機」可掃描它並使用此金鑰連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのカメラでスキャンして、このキーで接続できるQRコードを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone의 카메라로 스캔해 이 키로 연결할 수 있는 QR 코드를 표시해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงคิวอาร์โค้ดที่กล้องของ iPhone สแกนเพื่อเชื่อมต่อด้วยคีย์นี้ได้"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um código QR que a Câmara do iPhone pode ler para ligar com esta chave."
          }
        }
      }
    },
    "Shows a QR code. Scan it with the iPhone's Camera and Vane connects with this key.": {
