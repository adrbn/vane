            "value": "Kommer med Apples första analysrapport"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommer med Apples første analyserapport"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommer med Apples første analyserapport"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saapuu Applen ensimmäisen analytiikkaraportin mukana"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawi się z pierwszym raportem analitycznym Apple"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorazí s prvním analytickým přehledem od Applu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apare odată cu primul raport de analiză de la Apple"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’явиться з першим звітом аналітики Apple"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζεται με την πρώτη αναφορά αναλύσεων της Apple"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随 Apple 的首份分析报告送达"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨 Apple 的首份分析報告送達"
          }
        },
