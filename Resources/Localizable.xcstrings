    "Milestones and anything that needs attention, found by a background refresh.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fites i tot allò que requereix atenció, detectat per una actualització en segon pla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilensteine und alles, was Aufmerksamkeit braucht, bei einer Aktualisierung im Hintergrund gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitos y todo lo que requiere atención, detectado en una actualización en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paliers et tout ce qui demande votre attention, repérés lors d'une actualisation en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traguardi e tutto ciò che richiede attenzione, trovati da un aggiornamento in background."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mijlpalen en alles wat aandacht nodig heeft, gevonden door een vernieuwing op de achtergrond."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcos e tudo o que precisa de atenção, encontrados por uma atualização em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достижения и всё, что требует внимания, найденное фоновым обновлением."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dönüm noktaları ve dikkat gerektiren her şey, arka plandaki bir yenilemeyle bulunur."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Milstolpar och sådant som behöver din uppmärksamhet, hittade av en bakgrundsuppdatering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Milepæler og alt som trenger oppmerksomhet, funnet av en bakgrunnsoppdatering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Milepæle og alt, der kræver opmærksomhed, fundet af en baggrundsopdatering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Virstanpylväät ja kaikki huomiota vaativa, löydetty taustapäivityksellä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamienie milowe i wszystko, co wymaga uwagi, wykryte podczas odświeżania w tle."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Milníky a vše, co vyžaduje pozornost, nalezené obnovením na pozadí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Borne și tot ce necesită atenție, găsite de o reîmprospătare în fundal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Етапи та все, що потребує уваги, знайдене фоновим оновленням."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορόσημα και ό,τι χρειάζεται προσοχή, που εντοπίζονται από μια ανανέωση στο παρασκήνιο."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里程碑以及任何需要关注的内容，由后台刷新发现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "里程碑以及任何需要關注的內容，由背景重新整理發現。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイルストーンや対応が必要なことを、バックグラウンド更新で見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 새로 고침에서 찾은 이정표와 주의가 필요한 사항이에요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
