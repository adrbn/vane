    "Confirm. Your numbers load in a few seconds.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma. Les teves xifres es carreguen en pocs segons."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen. Ihre Zahlen laden in wenigen Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma. Tus cifras se cargan en unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez. Vos chiffres se chargent en quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma. I tuoi numeri si caricano in pochi secondi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig. Je cijfers laden binnen een paar seconden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme. Seus números carregam em poucos segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите. Данные загрузятся через несколько секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylayın. Rakamlarınız birkaç saniyede yüklenir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekräfta. Dina siffror laddas om några sekunder."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekreft. Tallene dine lastes på noen sekunder."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft. Dine tal indlæses på få sekunder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvista. Lukusi latautuvat muutamassa sekunnissa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź. Twoje liczby wczytają się w kilka sekund."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrďte. Vaše čísla se načtou za pár sekund."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmă. Cifrele tale se încarcă în câteva secunde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте. Ваші дані завантажаться за кілька секунд."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιβεβαιώστε. Οι αριθμοί σας φορτώνουν σε λίγα δευτερόλεπτα."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后，你的数据将在几秒内载入。"
