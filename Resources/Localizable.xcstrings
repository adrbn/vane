          "stringUnit": {
            "state": "translated",
            "value": "Edite seus metadados e responda a resenhas em um só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняйте метаданные и отвечайте на отзывы в одном месте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meta verilerinizi düzenleyin ve yorumları tek yerden yanıtlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigera dina metadata och svara på recensioner på ett ställe."
          }
        },
