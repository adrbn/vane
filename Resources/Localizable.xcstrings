      }
    },
    "Now. Downloads, proceeds and territories, as far back as Apple keeps them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora. Descargas, ingresos netos y territorios, desde donde Apple los conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout de suite. Téléchargements, produits et territoires, aussi loin qu'Apple les conserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora. Download, ricavi e territori, fin dove Apple li conserva."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara. Baixades, ingressos i territoris, tan enrere com Apple els conserva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt. Downloads, Einnahmen und Länder oder Regionen, so weit zurück, wie Apple sie vorhält."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi. İndirmeler, kazançlar ve bölgeler, Apple'ın tuttuğu en eski tarihe kadar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас. Загрузки, доход и регионы за весь срок, который хранит Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu. Downloads, opbrengst en regio's, zo ver terug als Apple ze bewaart."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora. Downloads, receita líquida e territórios, até onde a Apple mantém o histórico."
          }
        }
      }
    },
    "Of every 1,000 people who saw %@, %@ opened its page and %@ downloaded it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Of every 1,000 people who saw %1$@, %2$@ opened its page and %3$@ downloaded it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1000 personas que vieron %@, %@ abrieron su página y %@ la descargaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur 1 000 personnes qui ont vu %@, %@ ont ouvert sa page et %@ l'ont téléchargée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni 1.000 persone che hanno visto %@, %@ hanno aperto la pagina e %@ l’hanno scaricata."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1.000 persones que han vist %1$@, %2$@ n'han obert la pàgina i %3$@ l'han baixada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von je 1.000 Personen, die %1$@ gesehen haben, haben %2$@ die Seite geöffnet und %3$@ die App geladen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uygulamasını gören her 1.000 kişiden %2$@ sayfasını açtı ve %3$@ indirdi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из каждой 1000 человек, увидевших %1$@, страницу открыли %2$@ и загрузили %3$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van elke 1.000 mensen die %1$@ zagen, openden %2$@ de pagina en downloadden %3$@ de app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De cada 1.000 pessoas que viram %1$@, %2$@ abriram a página e %3$@ baixaram."
          }
        }
      }
    },
