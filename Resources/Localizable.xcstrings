    "Claude Code is signed out. Run claude /login in Terminal, then try again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code té la sessió tancada. Executa claude /login al Terminal i torna-ho a provar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist abgemeldet. Führen Sie claude /login im Terminal aus und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ha cerrado la sesión. Ejecuta claude /login en Terminal y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code est déconnecté. Exécutez claude /login dans Terminal, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code non ha effettuato l’accesso. Esegui claude /login nel Terminale, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code is uitgelogd. Voer claude /login uit in Terminal en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code está desconectado. Execute claude /login no Terminal e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнен выход из Claude Code. Выполните claude /login в Терминале и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code'un oturumu kapalı. Terminal'de claude /login çalıştırın, sonra tekrar deneyin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code är utloggad. Kör claude /login i Terminal och försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code er logget ut. Kjør claude /login i Terminal, og prøv igjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code er logget ud. Kør claude /login i Terminal, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code on kirjautunut ulos. Suorita claude /login Terminalissa ja yritä sitten uudelleen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code jest wylogowany. Uruchom claude /login w Terminalu, a następnie spróbuj ponownie."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code je odhlášen. Spusťte v Terminálu claude /login a zkuste to znovu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code este deconectat. Rulează claude /login în Terminal, apoi încearcă din nou."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code вийшов із облікового запису. Виконайте claude /login у Терміналі та повторіть спробу."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Claude Code είναι αποσυνδεδεμένο. Εκτελέστε claude /login στο Terminal και δοκιμάστε ξανά."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 已退出登录。请在终端中运行 claude /login，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code 已退出登入。請在終端機中執行 claude /login，然後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Codeからサインアウトされています。ターミナルでclaude /loginを実行してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 로그아웃되어 있어요. 터미널에서 claude /login을 실행한 다음 다시 시도하세요."
          }
        },
