    "Opens a second Vane with demo apps and every metric filled in. Your data isn't touched.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre un segon Vane amb apps de demostració i totes les mètriques omplertes. Les teves dades no es toquen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet ein zweites Vane mit Demo-Apps und allen ausgefüllten Kennzahlen. Ihre Daten bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un segundo Vane con apps de demostración y todas las métricas rellenas. Tus datos no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une seconde fenêtre Vane avec des apps de démo et tous les indicateurs remplis. Vos données ne sont pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una seconda finestra di Vane con app demo e ogni metrica compilata. I tuoi dati non vengono toccati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een tweede Vane met demo-apps en alle meetwaarden ingevuld. Je gegevens blijven onaangeroerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um segundo Vane com apps de demonstração e todas as métricas preenchidas. Seus dados não são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает второй Vane с демо-приложениями и всеми заполненными метриками. Ваши данные не затрагиваются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo uygulamalar ve tüm ölçütleri dolu ikinci bir Vane açar. Verilerinize dokunulmaz."
          }
        }
      }
    },
