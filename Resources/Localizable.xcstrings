    "No downloads yet. Sales reports arrive a day after the first sale.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha baixades. Els informes de vendes arriben un dia després de la primera venda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Downloads. Verkaufsberichte kommen einen Tag nach dem ersten Verkauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay descargas. Los informes de ventas llegan un día después de la primera venta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun téléchargement pour l'instant. Les rapports de ventes arrivent le lendemain de la première vente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun download. I report di vendita arrivano un giorno dopo la prima vendita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen downloads. Verkooprapporten komen een dag na de eerste verkoop binnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem downloads. Os relatórios de vendas chegam um dia depois da primeira venda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузок пока нет. Отчёты о продажах приходят через день после первой продажи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz indirme yok. Satış raporları ilk satıştan bir gün sonra gelir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga nedladdningar än. Försäljningsrapporter kommer en dag efter den första försäljningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nedlastinger ennå. Salgsrapporter kommer en dag etter det første salget."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen downloads endnu. Salgsrapporter kommer en dag efter det første salg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä latauksia. Myyntiraportit saapuvat päivän ensimmäisen myynnin jälkeen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie ma pobrań. Raporty sprzedaży pojawiają się dzień po pierwszej sprzedaży."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná stažení. Přehledy prodeje přicházejí den po prvním prodeji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nicio descărcare. Rapoartele de vânzări ajung la o zi după prima vânzare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажень ще немає. Звіти про продажі надходять за день після першого продажу."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμα λήψεις. Οι αναφορές πωλήσεων φτάνουν μία ημέρα μετά την πρώτη πώληση."
          }
        },
        "zh-Hans": {
