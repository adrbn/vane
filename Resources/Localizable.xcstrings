    "Tap Scan the Code on Your Mac, or point the Camera here.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escaneja el codi del teu Mac o apunta la càmera aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf „Code auf Ihrem Mac scannen“ oder richten Sie die Kamera hierher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Escanear el código en tu Mac o apunta la cámara aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Scanner le code sur votre Mac, ou pointez l'appareil photo ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Inquadra il codice sul tuo Mac, oppure punta la Fotocamera qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Scan de code op je Mac, of richt de camera hierop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Leia o código no seu Mac ou aponte a Câmera para cá."
          }
