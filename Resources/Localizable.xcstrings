    "%lld downloads this week, up from about %lld a week. A localized listing for this market could compound it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld baixades aquesta setmana, abans unes %2$lld per setmana. Una fitxa localitzada per a aquest mercat podria reforçar-ho."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld Downloads diese Woche, zuvor etwa %2$lld pro Woche. Eine lokalisierte Produktseite für diesen Markt könnte das verstärken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld downloads this week, up from about %2$lld a week. A localized listing for this market could compound it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld descargas esta semana, frente a unas %lld por semana. Una ficha localizada para este mercado podría impulsarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld téléchargements cette semaine, contre environ %lld par semaine d'habitude. Une fiche localisée pour ce marché pourrait amplifier la hausse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld download questa settimana, rispetto a circa %lld a settimana. Una scheda localizzata per questo mercato potrebbe amplificare il risultato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld downloads deze week, tegenover ongeveer %2$lld per week. Een gelokaliseerde vermelding voor deze markt kan dit versterken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld downloads esta semana, ante cerca de %2$lld por semana. Uma página localizada para este mercado poderia ampliar o resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузок на этой неделе: %1$lld, раньше около %2$lld в неделю. Локализованная карточка для этого рынка могла бы усилить рост."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hafta %1$lld indirme; önceden haftada yaklaşık %2$lld idi. Bu pazar için yerelleştirilmiş bir mağaza sayfası artışı büyütebilir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld nedladdningar den här veckan, upp från ungefär %2$lld i veckan. En lokaliserad produktsida för den här marknaden kan förstärka det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld nedlastinger denne uken, opp fra omtrent %2$lld i uken. En lokalisert produktside for dette markedet kan forsterke det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld downloads i denne uge, op fra ca. %2$lld om ugen. En lokaliseret produktside til dette marked kan forstærke det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld latausta tällä viikolla, aiemmin noin %2$lld viikossa. Tämän markkinan lokalisoitu esittely voisi vahvistaa kasvua."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld pobrań w tym tygodniu, wcześniej około %2$lld tygodniowo. Zlokalizowany wpis dla tego rynku mógłby to wzmocnić."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld stažení tento týden, dříve asi %2$lld týdně. Lokalizovaný záznam pro tento trh by to mohl znásobit."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld descărcări săptămâna aceasta, față de aproximativ %2$lld pe săptămână. O pagină localizată pentru această piață ar putea amplifica rezultatul."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажень цього тижня: %1$lld, було близько %2$lld на тиждень. Локалізована картка для цього ринку могла б підсилити результат."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld λήψεις αυτήν την εβδομάδα, από περίπου %2$lld την εβδομάδα. Μια τοπικοποιημένη σελίδα για αυτήν την αγορά θα μπορούσε να το ενισχύσει."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周下载 %1$lld 次，高于每周约 %2$lld 次的水平。为该市场提供本地化的商店信息可能会进一步放大增长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週下載 %1$lld 次，高於每週約 %2$lld 次的水平。為該市場提供本地化的商店資訊可能會進一步放大增長。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今週のダウンロードは%1$lld件で、通常の週約%2$lld件から増えています。この市場向けにローカライズした掲載情報を用意すると、さらに伸びる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 주 다운로드 %1$lld건으로, 주당 약 %2$lld건에서 늘었어요. 이 시장에 맞춘 현지화 정보가 효과를 더 키울 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
