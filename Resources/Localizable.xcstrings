          "stringUnit": {
            "state": "translated",
            "value": "Rediger metadataene dine og svar på anmeldelser på ett sted."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediger dine metadata og besvar anmeldelser ét sted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokkaa metatietoja ja vastaa arvosteluihin yhdessä paikassa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuj metadane i odpowiadaj na recenzje w jednym miejscu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravujte metadata a odpovídejte na recenze na jednom místě."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Editează-ți metadatele și răspunde la recenzii într-un singur loc."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Редагуйте метадані та відповідайте на відгуки в одному місці."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επεξεργαστείτε τα μεταδεδομένα σας και απαντήστε στις κριτικές σε ένα μέρος."
