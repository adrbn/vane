    "Leave empty for your usual account. For another one, sign in with CLAUDE_CONFIG_DIR=<folder> claude, then enter that folder.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa-ho buit per al teu compte habitual. Per a un altre, inicia sessió amb CLAUDE_CONFIG_DIR=<carpeta> claude i escriu aquí aquella carpeta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen für dein übliches Konto. Für ein anderes melde dich mit CLAUDE_CONFIG_DIR=<Ordner> claude an und gib dann diesen Ordner ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para tu cuenta habitual. Para otra, inicia sesión con CLAUDE_CONFIG_DIR=<carpeta> claude y luego escribe esa carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour votre compte habituel. Pour un autre, connectez-vous avec CLAUDE_CONFIG_DIR=<dossier> claude, puis indiquez ce dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per il tuo account abituale. Per un altro, accedi con CLAUDE_CONFIG_DIR=<cartella> claude, poi inserisci quella cartella."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg voor je gewone account. Voor een ander log je in met CLAUDE_CONFIG_DIR=<map> claude en vul je die map hier in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe vazio para a sua conta habitual. Para outra, inicie sessão com CLAUDE_CONFIG_DIR=<pasta> claude e depois indique essa pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым для обычного аккаунта. Для другого войдите через CLAUDE_CONFIG_DIR=<папка> claude и укажите эту папку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zamanki hesabınız için boş bırakın. Başka biri için CLAUDE_CONFIG_DIR=<klasör> claude ile oturum açın, sonra o klasörü girin."
          }
        }
      }
    },
