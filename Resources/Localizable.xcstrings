    "A thin line glides under each screen's title until the refresh ends.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línia fina llisca sota el títol de cada pantalla fins que acaba l'actualització."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine dünne Linie gleitet unter dem Titel jedes Bildschirms, bis die Aktualisierung endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea fina se desliza bajo el título de cada pantalla hasta que termina la actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fine ligne glisse sous le titre de chaque écran jusqu'à la fin de l'actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una linea sottile scorre sotto il titolo di ogni schermata finché l'aggiornamento non finisce."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dunne lijn glijdt onder de titel van elk scherm tot het verversen klaar is."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha fina desliza sob o título de cada tela até a atualização terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha fina desliza sob o título de cada ecrã até a atualização terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкая линия скользит под заголовком каждого экрана, пока идёт обновление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenileme bitene kadar her ekranın başlığının altında ince bir çizgi kayar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tunn linje glider under varje skärms rubrik tills uppdateringen är klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tynn linje glir under tittelen på hver skjerm til oppdateringen er ferdig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tynd linje glider under hver skærms titel, indtil opdateringen er færdig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohut viiva liukuu jokaisen näkymän otsikon alla, kunnes päivitys päättyy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cienka linia przesuwa się pod tytułem każdego ekranu do końca odświeżania."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod názvem každé obrazovky klouže tenká čára, dokud obnovování neskončí."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O linie subțire alunecă sub titlul fiecărui ecran până se termină reîmprospătarea."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонка лінія ковзає під заголовком кожного екрана, доки триває оновлення."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια λεπτή γραμμή κυλά κάτω από τον τίτλο κάθε οθόνης μέχρι να τελειώσει η ανανέωση."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新结束前，每个页面标题下会有一条细线滑动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新整理結束前，每個畫面標題下會有一條細線滑動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新が終わるまで、各画面のタイトルの下を細いラインが流れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침이 끝날 때까지 각 화면 제목 아래로 가는 선이 움직입니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นบางๆ เลื่อนอยู่ใต้ชื่อของแต่ละหน้าจนกว่าการรีเฟรชจะเสร็จ"
          }
        }
      }
    },
