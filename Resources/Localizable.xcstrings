    "Friday to Sunday bring %@ more sales per day than the rest of the week. Time releases and promotions for Thursday.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De viernes a domingo hay %@ más ventas al día que el resto de la semana. Programa lanzamientos y promociones para el jueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vendredi au dimanche, vous vendez %@ de plus par jour que le reste de la semaine. Prévoyez vos versions et promotions pour le jeudi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da venerdì a domenica le vendite giornaliere sono superiori del %@ rispetto al resto della settimana. Programma uscite e promozioni per il giovedì."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De divendres a diumenge hi ha %@ més vendes per dia que la resta de la setmana. Programa llançaments i promocions per al dijous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Freitag bis Sonntag gibt es pro Tag %@ mehr Verkäufe als an den übrigen Tagen. Planen Sie Releases und Aktionen für Donnerstag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma ile Pazar arası, haftanın geri kalanına göre günlük %@ daha fazla satış getiriyor. Sürümleri ve promosyonları Perşembe gününe denk getirin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С пятницы по воскресенье продаж в день на %@ больше, чем в остальные дни недели. Планируйте релизы и акции на четверг."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijdag t/m zondag brengen %@ meer verkopen per dag op dan de rest van de week. Plan releases en acties voor donderdag."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De sexta a domingo, as vendas diárias são %@ maiores que no resto da semana. Programe lançamentos e promoções para a quinta-feira."
          }
        }
      }
    },
