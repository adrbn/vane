    "No written reviews yet. They show up here and in Reviews as people write them.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha ressenyes escrites. Apareixeran aquí i a Ressenyes a mesura que la gent les escrigui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Rezensionen mit Text. Sie erscheinen hier und unter „Rezensionen“, sobald sie geschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay reseñas escritas. Aparecerán aquí y en Reseñas cuando la gente las escriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun avis écrit pour l'instant. Ils apparaissent ici et dans Avis au fur et à mesure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna recensione scritta. Compaiono qui e in Recensioni man mano che le persone le scrivono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen geschreven recensies. Ze verschijnen hier en onder Recensies zodra mensen ze schrijven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem resenhas escritas. Elas aparecem aqui e em Resenhas conforme as pessoas as escrevem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отзывов с текстом пока нет. Они появятся здесь и в разделе «Отзывы», как только люди их напишут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yazılı yorum yok. İnsanlar yazdıkça burada ve Yorumlar'da görünür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga skrivna recensioner än. De visas här och under Recensioner när folk skriver dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen skrevne anmeldelser ennå. De vises her og under Anmeldelser etter hvert som folk skriver dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen skrevne anmeldelser endnu. De vises her og under Anmeldelser, efterhånden som folk skriver dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä kirjoitettuja arvosteluja. Ne näkyvät täällä ja Arvosteluissa sitä mukaa, kun ihmiset kirjoittavat niitä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak napisanych recenzji. Pojawią się tutaj i w Recenzjach, gdy ludzie je napiszą."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné napsané recenze. Objeví se tady a v Recenzích, jakmile je lidé napíšou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nicio recenzie scrisă. Apar aici și în Recenzii pe măsură ce oamenii le scriu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Письмових відгуків ще немає. Вони з’являтимуться тут і в розділі «Відгуки», щойно люди їх писатимуть."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν ακόμα γραπτές κριτικές. Εμφανίζονται εδώ και στις Κριτικές καθώς τις γράφουν οι χρήστες."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有文字评论。用户写下后，会显示在这里和“评论”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有文字評論。使用者寫下後，會顯示在這裡和「評論」中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメント付きレビューはまだありません。投稿されると、ここと「レビュー」に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 작성된 리뷰가 없어요. 사람들이 작성하면 여기와 리뷰에 표시돼요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีรีวิวที่เขียน รีวิวจะแสดงที่นี่และในรีวิวเมื่อผู้คนเขียน"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem avaliações escritas. Aparecem aqui e em Avaliações à medida que as pessoas as escrevem."
          }
        }
      }
    },
