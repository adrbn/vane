          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านคีย์ส่วนตัวไม่ได้ วางเนื้อหาทั้งหมดของไฟล์ AuthKey_XXXX.p8"
          }
        },
        "pt-PT": {
