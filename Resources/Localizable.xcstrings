    "That's every written review. New ones arrive with each refresh.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esas son todas las reseñas escritas. Las nuevas llegan con cada actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont tous les avis écrits. Les nouveaux arrivent à chaque actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tutte le recensioni scritte. Le nuove arrivano a ogni aggiornamento."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquestes són totes les ressenyes escrites. Les noves arriben amb cada actualització."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
