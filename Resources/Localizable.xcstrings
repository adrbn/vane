    "You're looking at demo apps. Connect your key in Settings → App Store Connect whenever you're ready.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estàs veient apps de demostració. Connecta la teva clau a Configuració → App Store Connect quan vulguis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sehen Demo-Apps. Verbinden Sie Ihren Schlüssel jederzeit unter Einstellungen → App Store Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo apps de demostración. Conecta tu clave en Ajustes → App Store Connect cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez des apps de démo. Connectez votre clé dans Réglages → App Store Connect quand vous voulez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai guardando app demo. Connetti la tua chiave in Impostazioni → App Store Connect quando vuoi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bekijkt demo-apps. Verbind je sleutel in Instellingen → App Store Connect wanneer je er klaar voor bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo apps de demonstração. Conecte sua chave em Ajustes → App Store Connect quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы смотрите демо-приложения. Подключите ключ в разделе «Настройки» → App Store Connect, когда будете готовы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo uygulamalara bakıyorsunuz. Hazır olduğunuzda anahtarınızı Ayarlar → App Store Connect bölümünden bağlayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tittar på demoappar. Anslut din nyckel i Inställningar → App Store Connect när du är redo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser på demoapper. Koble til nøkkelen din i Innstillinger → App Store Connect når du er klar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser på demoapps. Tilslut din nøgle i Indstillinger → App Store Connect, når du er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsot demosovelluksia. Yhdistä avaimesi kohdassa Asetukset → App Store Connect, kun olet valmis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądasz aplikacje demo. Połącz swój klucz w Ustawienia → App Store Connect, gdy będziesz gotowy."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohlížíte si demo aplikace. Až budete připraveni, připojte svůj klíč v Nastavení → App Store Connect."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Te uiți la aplicații demo. Conectează-ți cheia în Setări → App Store Connect când ești gata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви дивитеся демонстраційні застосунки. Підключіть ключ у Параметри → App Store Connect, коли будете готові."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βλέπετε εφαρμογές demo. Συνδέστε το κλειδί σας στις Ρυθμίσεις → App Store Connect όποτε είστε έτοιμοι."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在查看演示 App。准备好后，随时可在“设置”→ App Store Connect 中连接你的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
