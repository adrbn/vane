    "Opens a second Vane with demo apps and every metric filled in. Your data isn't touched.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre un segon Vane amb apps de demostració i totes les mètriques omplertes. Les teves dades no es toquen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet ein zweites Vane mit Demo-Apps und allen ausgefüllten Kennzahlen. Ihre Daten bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un segundo Vane con apps de demostración y todas las métricas rellenas. Tus datos no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une seconde fenêtre Vane avec des apps de démo et tous les indicateurs remplis. Vos données ne sont pas modifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una seconda finestra di Vane con app demo e ogni metrica compilata. I tuoi dati non vengono toccati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een tweede Vane met demo-apps en alle meetwaarden ingevuld. Je gegevens blijven onaangeroerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um segundo Vane com apps de demonstração e todas as métricas preenchidas. Seus dados não são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает второй Vane с демо-приложениями и всеми заполненными метриками. Ваши данные не затрагиваются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo uygulamalar ve tüm ölçütleri dolu ikinci bir Vane açar. Verilerinize dokunulmaz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar ett andra Vane med demoappar och alla mått ifyllda. Dina data berörs inte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner en ekstra Vane med demoapper og alle tall utfylt. Dataene dine berøres ikke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner endnu en Vane med demoapps og alle tal udfyldt. Dine data berøres ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa toisen Vanen, jossa on demosovelluksia ja kaikki mittarit täytettyinä. Tietoihisi ei kosketa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera drugą instancję Vane z aplikacjami demo i wszystkimi wskaźnikami wypełnionymi. Twoje dane pozostają nietknięte."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře druhý Vane s demo aplikacemi a všemi metrikami vyplněnými. Vaše data zůstávají nedotčena."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide un al doilea Vane cu aplicații demo și toți indicatorii completați. Datele tale nu sunt atinse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває другий Vane з демонстраційними застосунками й усіма показниками. Ваші дані не зачіпаються."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει ένα δεύτερο Vane με εφαρμογές demo και όλες τις μετρήσεις συμπληρωμένες. Τα δικά σας δεδομένα δεν επηρεάζονται."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开另一个 Vane，里面有演示 App 和填充好的所有指标。你的数据不会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟另一個 Vane，裡面有演示 App 和填充好的所有指標。你的資料不會受到影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモAppとすべての指標が入力された2つ目のVaneを開きます。ご自身のデータには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데모 앱과 모든 지표가 채워진 두 번째 Vane을 열어요. 내 데이터는 변경되지 않아요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Vane ตัวที่สองพร้อมแอปเดโมและตัวชี้วัดครบทุกอย่าง ข้อมูลของคุณไม่ถูกแตะต้อง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um segundo Vane com apps de demonstração e todas as métricas preenchidas. Os seus dados não são alterados."
          }
        }
      }
    },
