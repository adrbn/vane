    "Nothing new. Vane writes one when a number moves outside its usual range.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Res de nou. Vane en escriu una quan una xifra surt del seu rang habitual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Neues. Vane schreibt eine, sobald eine Zahl ihren üblichen Bereich verlässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nuevo. Vane escribe una cuando una cifra se sale de su rango habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de nouveau. Vane en rédige une quand un chiffre sort de sa plage habituelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di nuovo. Vane ne scrive uno quando un numero esce dal suo intervallo abituale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets nieuws. Vane schrijft er een als een cijfer buiten het gebruikelijke bereik komt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de novo. O Vane escreve um quando um número sai da faixa habitual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего нового. Vane напишет, когда показатель выйдет за обычный диапазон."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir şey yok. Bir rakam olağan aralığının dışına çıktığında Vane bir içgörü yazar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget nytt. Vane skriver en när ett värde hamnar utanför sitt vanliga intervall."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting nytt. Vane skriver en når et tall havner utenfor sitt vanlige område."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet nyt. Vane skriver en, når et tal havner uden for sit sædvanlige interval."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei mitään uutta. Vane kirjoittaa uuden, kun luku siirtyy tavanomaisen vaihteluvälin ulkopuolelle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nowego. Vane napisze nowy wniosek, gdy liczba wyjdzie poza zwykły zakres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nového. Vane napíše nový postřeh, když se číslo dostane mimo obvyklý rozsah."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic nou. Vane scrie una când un număr iese din intervalul obișnuit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого нового. Vane напише, коли показник вийде за звичний діапазон."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα νέο. Το Vane γράφει μία όταν ένας αριθμός βγει εκτός του συνηθισμένου εύρους του."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有新内容。当某个数值超出常规范围时，Vane 会写一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有新內容。當某個數值超出常規範圍時，Vane 會寫一條。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいものはありません。数値が通常の範囲を外れると、Vaneが1件作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 내용이 없어요. 어떤 수치가 평소 범위를 벗어나면 Vane이 알려 드려요."
          }
        },
        "th": {
