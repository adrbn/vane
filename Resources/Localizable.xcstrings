    "Browse traffic is %lld× its usual level, mostly in %@. An App Store feature or chart placement would explain it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Browse traffic is %1$lld× its usual level, mostly in %2$@. An App Store feature or chart placement would explain it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tráfico de exploración es %lld× su nivel habitual, sobre todo en %@. Un destacado en el App Store o una posición en las listas lo explicaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trafic de navigation atteint %lld× son niveau habituel (surtout : %@). Une mise en avant sur l'App Store ou une entrée dans un classement l'expliquerait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il traffico da esplorazione è %lld× il livello abituale, soprattutto in %@. Potrebbe dipendere da una segnalazione o da un posizionamento in classifica sull’App Store."
          }
        }
      }
    },
