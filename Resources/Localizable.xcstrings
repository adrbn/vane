    },
    "The subtitle is indexed for search and shown under your name. 30 free characters are going unused.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El subtítulo se indexa para la búsqueda y aparece bajo tu nombre. Hay 30 caracteres libres sin usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sous-titre est indexé pour la recherche et affiché sous votre nom. 30 caractères disponibles restent inutilisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sottotitolo è indicizzato per la ricerca e mostrato sotto il nome. 30 caratteri liberi non vengono usati."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El subtítol s'indexa per a la cerca i es mostra sota el nom. Hi ha 30 caràcters lliures sense usar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Untertitel wird für die Suche indexiert und unter Ihrem Namen angezeigt. 30 freie Zeichen bleiben ungenutzt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt başlık aramada dizinlenir ve adınızın altında gösterilir. 30 boş karakter kullanılmıyor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подзаголовок индексируется для поиска и отображается под названием. 30 свободных символов не используются."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertitel wordt geïndexeerd voor zoeken en staat onder je naam. 30 vrije tekens blijven ongebruikt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O subtítulo é indexado para busca e aparece abaixo do seu nome. 30 caracteres livres estão sem uso."
          }
        }
      }
    },
    "This %@ isn't fully covered by the sales reports yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de ventas aún no cubren por completo el periodo (%@ actual)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Période (%@) pas encore entièrement couverte par les rapports de ventes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo periodo (%@) non è ancora coperto del tutto dai report di vendita"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest %@ encara no està del tot cobert pels informes de vendes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zeitraum (%@) ist von den Verkaufsberichten noch nicht vollständig abgedeckt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu %@ henüz satış raporlarınca tam olarak kapsanmıyor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот период (%@) пока не полностью охвачен отчётами о продажах"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze %@ wordt nog niet volledig gedekt door de verkooprapporten"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este período (%@) ainda não está totalmente coberto pelos relatórios de vendas"
          }
        }
      }
    },
    "This code holds your private key. Don't screenshot or share it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código contiene tu clave privada. No hagas capturas ni lo compartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code contient votre clé privée. Ne le capturez pas et ne le partagez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo codice contiene la tua chiave privata. Non farne screenshot e non condividerlo."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest codi conté la teva clau privada. No en facis captures ni el comparteixis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code enthält Ihren privaten Schlüssel. Machen Sie keinen Screenshot und teilen Sie ihn nicht."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kod özel anahtarınızı içerir. Ekran görüntüsünü almayın veya paylaşmayın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код содержит ваш закрытый ключ. Не делайте с ним скриншоты и не делитесь им."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze code bevat je privésleutel. Maak er geen schermafbeelding van en deel hem niet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código contém sua chave privada. Não tire captura de tela nem o compartilhe."
          }
        }
      }
    },
    "This device can't scan. Point the iPhone's Camera at the code instead, or use your own key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no puede escanear. Apunta la cámara del iPhone al código o usa tu propia clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut pas scanner. Pointez plutôt l'appareil photo de l'iPhone vers le code, ou utilisez votre propre clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non può inquadrare codici. Punta invece la Fotocamera dell’iPhone sul codice, oppure usa la tua chiave."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest dispositiu no pot escanejar. Apunta la càmera de l'iPhone al codi o fes servir la teva pròpia clau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann nicht scannen. Richten Sie stattdessen die Kamera des iPhone auf den Code oder verwenden Sie Ihren eigenen Schlüssel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz tarama yapamıyor. Bunun yerine iPhone Kamerası'nı koda doğrultun veya kendi anahtarınızı kullanın."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство не может сканировать. Наведите камеру iPhone на код или используйте собственный ключ."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat kan niet scannen. Richt in plaats daarvan de camera van de iPhone op de code, of gebruik je eigen sleutel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não consegue ler códigos. Aponte a Câmera do iPhone para o código ou use sua própria chave."
          }
        }
      }
    },
