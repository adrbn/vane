    "Add new comma-separated words in the space you freed. Don't repeat words from your name or subtitle.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix paraules noves separades per comes a l'espai que has alliberat. No repeteixis paraules del nom o del subtítol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie im freigewordenen Platz neue Wörter, durch Kommas getrennt, hinzu. Wiederholen Sie keine Wörter aus Ihrem Namen oder Untertitel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade palabras nuevas separadas por comas en el espacio liberado. No repitas palabras de tu nombre o subtítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez de nouveaux mots séparés par des virgules dans l'espace libéré. Ne reprenez pas les mots de votre nom ou sous-titre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi nuove parole separate da virgole nello spazio liberato. Non ripetere parole del nome o del sottotitolo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg nieuwe woorden, gescheiden door komma's, toe in de vrijgekomen ruimte. Herhaal geen woorden uit je naam of ondertitel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione palavras novas, separadas por vírgula, no espaço liberado. Não repita palavras do seu nome ou subtítulo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте новые слова через запятую в освободившееся место. Не повторяйте слова из названия или подзаголовка."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşalttığınız alana virgülle ayrılmış yeni kelimeler ekleyin. Ad veya alt başlığınızdaki kelimeleri tekrarlamayın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till nya kommaseparerade ord i det utrymme du frigjorde. Upprepa inte ord från namnet eller undertiteln."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til nye kommaseparerte ord i plassen du frigjorde. Ikke gjenta ord fra navnet eller undertittelen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj nye kommaseparerede ord i den plads, du frigjorde. Gentag ikke ord fra navnet eller undertitlen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää uusia pilkuilla erotettuja sanoja vapauttamaasi tilaan. Älä toista nimesi tai alaotsikkosi sanoja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nowe słowa oddzielone przecinkami w zwolnionym miejscu. Nie powtarzaj słów z nazwy ani podtytułu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do uvolněného místa přidejte nová slova oddělená čárkami. Neopakujte slova z názvu nebo podtitulu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă cuvinte noi, separate prin virgulă, în spațiul eliberat. Nu repeta cuvinte din nume sau subtitlu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте нові слова через кому у звільнене місце. Не повторюйте слова з назви чи підзаголовка."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε νέες λέξεις χωρισμένες με κόμμα στον χώρο που ελευθερώσατε. Μην επαναλαμβάνετε λέξεις από το όνομα ή τον υπότιτλο."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在腾出的空间里添加以逗号分隔的新词。不要重复名称或副标题中的词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在騰出的空間裡新增以逗號分隔的新詞。不要重複名稱或副標題中的詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いたスペースに、カンマ区切りで新しい語を追加してください。名前やサブタイトルにある語は繰り返さないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 둔 공간에 쉼표로 구분한 새 단어를 추가하세요. 이름이나 부제목의 단어는 반복하지 마세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มคำใหม่คั่นด้วยจุลภาคในที่ว่างที่คุณเว้นไว้ อย่าใช้คำซ้ำกับชื่อหรือคำบรรยายย่อย"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione palavras novas separadas por vírgulas no espaço que libertou. Não repita palavras do nome ou do subtítulo."
          }
        }
      }
    },
    "Add your App Store Connect key in Settings, then refresh.": {
      "localizations": {
