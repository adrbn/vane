    "Impressions were %@%@, product page views %@. Page conversion finished at %@ and tap-through at %@.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les impressions han estat %1$@%2$@, les visualitzacions de la pàgina de producte %3$@. La conversió ha acabat en %4$@ i la taxa de toc en %5$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Impressionen lagen bei %1$@%2$@, die Produktseitenaufrufe bei %3$@. Die Conversion endete bei %4$@, die Antipprate bei %5$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressions were %1$@%2$@, product page views %3$@. Conversion finished at %4$@ and tap-through at %5$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las impresiones fueron %@%@, las visualizaciones de la página de producto %@. La conversión cerró en %@ y el toque en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impressions : %@%@, vues de la page produit : %@. Taux de conversion : %@, taux de clics : %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impressioni sono state %@%@, le visualizzazioni della pagina prodotto %@. La conversione ha chiuso a %@ e il tasso di tocco a %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertoningen waren %1$@%2$@, productpaginaweergaven %3$@. Paginaconversie kwam uit op %4$@ en doorklikratio op %5$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As impressões foram %1$@%2$@ e as visualizações da página do produto, %3$@. A conversão terminou em %4$@ e a taxa de toque em %5$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показы: %1$@%2$@, просмотры страницы продукта: %3$@. Конверсия страницы: %4$@, доля переходов: %5$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterimler %1$@%2$@, ürün sayfası görüntülemeleri %3$@ oldu. Dönüşüm %4$@, dokunma oranı %5$@ ile bitti."
          }
        }
      }
    },
