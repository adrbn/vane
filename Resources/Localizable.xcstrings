        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kreeg %1$@ downloads op %2$@, meer dan op enige dag sinds %3$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você teve %1$@ downloads em %2$@, mais que em qualquer dia desde %3$@."
