    "“%@” already count from the name or subtitle. The space is better used for new words.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya cuentan desde el nombre o subtítulo. El espacio se aprovecha mejor con palabras nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » comptent déjà grâce au nom ou au sous-titre. Mieux vaut utiliser cet espace pour de nouveaux mots."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” già contano dal nome o dal sottotitolo. Lo spazio è meglio usato per parole nuove."
          }
        }
      }
    },
