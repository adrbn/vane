    "Couldn't find the %@ command. Install it and sign in, then try again.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat l'ordre %@. Instal·la-la, inicia la sessió i torna-ho a provar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl %@ wurde nicht gefunden. Installieren Sie ihn, melden Sie sich an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra el comando %@. Instálalo, inicia sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commande %@ introuvable. Installez-la et connectez-vous, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare il comando %@. Installalo ed effettua l’accesso, poi riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon de opdracht %@ niet vinden. Installeer die, log in en probeer het opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar o comando %@. Instale-o, faça login e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти команду %@. Установите её, войдите в систему и повторите попытку."
