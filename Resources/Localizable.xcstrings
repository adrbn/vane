    "Answer reviews and fix your metadata.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon ressenyes i corregeix les metadades."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworten Sie Rezensionen und korrigieren Sie Ihre Metadaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a las reseñas y corrige tus metadatos."
          }
        },
