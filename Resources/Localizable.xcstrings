            "value": "Vane kontrollerar dina data efter varje uppdatering och listar här det som är värt att veta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vane sjekker dataene dine etter hver oppdatering og lister her det som er verdt å vite."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
