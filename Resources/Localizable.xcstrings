          "stringUnit": {
            "state": "translated",
            "value": "Appleの最初の分析レポートとともに届きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 첫 분석 보고서와 함께 도착해요"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะมาพร้อมกับรายงานการวิเคราะห์ฉบับแรกของ Apple"
          }
        },
        "pt-PT": {
