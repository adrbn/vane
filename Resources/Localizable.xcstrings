    "Downloads were %@, %@. Impressions, product page views and first-time downloads arrive with Apple's first analytics report.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les baixades han estat %1$@, %2$@. Impressions, visualitzacions de la pàgina de producte i primeres baixades arriben amb el primer informe d'analítica d'Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Downloads lagen bei %1$@, %2$@. Impressionen, Produktseitenaufrufe und Erstdownloads kommen mit dem ersten Analytics-Bericht von Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Downloads were %1$@, %2$@. Impressions, product page views and first-time downloads arrive with Apple's first analytics report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas fueron %@, %@. Impresiones, visualizaciones de la página de producto y primeras descargas llegan con el primer informe de analíticas de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargements : %@, %@. Les impressions, vues de la page produit et premiers téléchargements arrivent avec le premier rapport d'analyse d'Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download sono stati %@, %@. Impressioni, visualizzazioni della pagina prodotto e primi download arrivano con il primo report di analisi di Apple."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads waren %1$@, %2$@. Vertoningen, productpaginaweergaven en eerste downloads komen binnen met Apples eerste analyserapport."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads foram %1$@, %2$@. Impressões, visualizações da página do produto e primeiros downloads chegam com o primeiro relatório de análises da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки: %1$@, %2$@. Показы, просмотры страницы продукта и первые загрузки появятся с первым аналитическим отчётом Apple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirmeler %1$@, %2$@ oldu. Gösterimler, ürün sayfası görüntülemeleri ve ilk indirmeler Apple'ın ilk analiz raporuyla gelir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedladdningarna var %1$@, %2$@. Visningar, produktsidvisningar och förstagångsnedladdningar kommer med Apples första analysrapport."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlastingene var %1$@, %2$@. Visninger, produktsidevisninger og førstegangsnedlastinger kommer med Apples første analyserapport."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads var %1$@, %2$@. Visninger, produktsidevisninger og førstegangsdownloads kommer med Apples første analyserapport."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Latauksia oli %1$@, %2$@. Näyttökerrat, tuotesivun katselut ja ensilataukset saapuvat Applen ensimmäisen analytiikkaraportin mukana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrań: %1$@, %2$@. Wyświetlenia, wyświetlenia strony produktu i pierwsze pobrania pojawią się wraz z pierwszym raportem analitycznym Apple."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stažení: %1$@, %2$@. Zobrazení, zobrazení stránky produktu a první stažení dorazí s prvním analytickým přehledem od Applu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcările au fost %1$@, %2$@. Afișările, vizualizările paginii de produs și primele descărcări apar odată cu primul raport de analiză de la Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажень: %1$@, %2$@. Покази, перегляди сторінки продукту та перші завантаження з’являться з першим звітом аналітики Apple."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λήψεις ήταν %1$@, %2$@. Οι εμφανίσεις, οι προβολές σελίδας προϊόντος και οι πρώτες λήψεις φτάνουν με την πρώτη αναφορά αναλύσεων της Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载量为 %1$@，%2$@。展示次数、产品页面查看次数和首次下载数据将随 Apple 的首份分析报告送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載量為 %1$@，%2$@。曝光次數、產品頁面檢視次數和首次下載資料將隨 Apple 的首份分析報告送達。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードは%1$@、%2$@でした。インプレッション、プロダクトページビュー、初回ダウンロードは、Appleの最初の分析レポートとともに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드는 %1$@, %2$@였어요. 노출수, 제품 페이지 조회수, 첫 다운로드는 Apple의 첫 분석 보고서와 함께 도착해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยอดดาวน์โหลดอยู่ที่ %1$@, %2$@ การแสดงผล การดูหน้าผลิตภัณฑ์ และการดาวน์โหลดครั้งแรกจะมาพร้อมกับรายงานการวิเคราะห์ฉบับแรกของ Apple"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências foram %1$@, %2$@. As impressões, as visualizações da página do produto e as primeiras transferências chegam com o primeiro relatório de análises da Apple."
          }
        }
      }
    },
