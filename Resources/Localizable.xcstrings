    "Sales history is here. Apple’s analytics start one to two days after the one-time step below.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historial de vendes ja és aquí. L'analítica d'Apple comença d'un a dos dies després del pas únic de sota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verkaufsverlauf ist da. Apples Analysen beginnen ein bis zwei Tage nach dem einmaligen Schritt unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de ventas ya está aquí. Las analíticas de Apple empiezan uno o dos días después del paso único de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique des ventes est là. Les analyses d'Apple commencent un à deux jours après l'étape unique ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo storico delle vendite è qui. Le analisi di Apple iniziano uno o due giorni dopo il passaggio unico qui sotto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verkoopgeschiedenis is binnen. Apples analyses beginnen één tot twee dagen na de eenmalige stap hieronder."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de vendas já está aqui. As análises da Apple começam um a dois dias depois do passo único abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История продаж уже здесь. Аналитика Apple начнётся через один-два дня после разового шага ниже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satış geçmişi burada. Apple analizleri aşağıdaki tek seferlik adımdan bir iki gün sonra başlar."
          }
        }
      }
    },
