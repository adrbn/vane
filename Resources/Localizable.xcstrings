    "Explain this insight and what I should do about it: %@. %@": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica'm aquesta observació i què hauria de fer: %@. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkläre mir diese Erkenntnis und was ich tun sollte: %@. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explícame esta observación y qué debería hacer: %@. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique-moi cette observation et ce que je dois faire : %@. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiegami questa osservazione e cosa dovrei fare: %@. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dit inzicht uit en wat ik moet doen: %@. %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Explique este insight e o que devo fazer: %@. %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объясни этот вывод и что мне делать: %@. %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içgörüyü ve ne yapmam gerektiğini açıkla: %@. %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förklara den här insikten och vad jag bör göra åt den: %1$@. %2$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklar denne innsikten og hva jeg bør gjøre med den: %1$@. %2$@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forklar denne indsigt, og hvad jeg bør gøre ved den: %1$@. %2$@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selitä tämä oivallus ja mitä minun pitäisi tehdä sen suhteen: %@. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyjaśnij ten wniosek i powiedz, co powinienem z nim zrobić: %@. %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysvětli tento postřeh a co s ním mám dělat: %@. %@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Explică-mi această informație și ce ar trebui să fac în privința ei: %@. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поясни цей інсайт і що мені з ним робити: %@. %@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξήγησέ μου αυτήν την πληροφορία και τι να κάνω γι’ αυτήν: %@. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请解释这条洞察以及我该怎么做：%@。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請解釋這條洞察以及我該怎麼做：%@。%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインサイトの内容と、私が取るべき対応を説明してください: %@。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인사이트가 무슨 뜻인지, 무엇을 해야 할지 설명해 줘: %@. %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อธิบายข้อมูลเชิงลึกนี้และสิ่งที่ฉันควรทำ: %@. %@"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Explica-me esta informação e o que devo fazer a esse respeito: %@. %@"
          }
        }
      }
    },
