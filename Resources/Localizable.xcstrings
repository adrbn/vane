            "state": "translated",
            "value": "Je eerste App Store-rapport komt binnen 24–48 uur binnen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu primeiro relatório da App Store chega em 24 a 48 horas"
          }
        },
        "ru": {
