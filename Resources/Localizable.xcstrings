          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre clé App Store Connect dans les réglages, puis actualisez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la tua chiave App Store Connect in Impostazioni, poi aggiorna."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je App Store Connect-sleutel toe in Instellingen en vernieuw daarna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua chave do App Store Connect em Ajustes e depois atualize."
          }
        },
        "ru": {
          "stringUnit": {
