    "Friday to Sunday bring %@ more sales per day than the rest of the week. Time releases and promotions for Thursday.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De divendres a diumenge hi ha %@ més vendes per dia que la resta de la setmana. Programa llançaments i promocions per al dijous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Freitag bis Sonntag gibt es pro Tag %@ mehr Verkäufe als an den übrigen Tagen. Planen Sie Releases und Aktionen für Donnerstag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De viernes a domingo hay %@ más ventas al día que el resto de la semana. Programa lanzamientos y promociones para el jueves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vendredi au dimanche, vous vendez %@ de plus par jour que le reste de la semaine. Prévoyez vos versions et promotions pour le jeudi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da venerdì a domenica le vendite giornaliere sono superiori del %@ rispetto al resto della settimana. Programma uscite e promozioni per il giovedì."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijdag t/m zondag brengen %@ meer verkopen per dag op dan de rest van de week. Plan releases en acties voor donderdag."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "De sexta a domingo, as vendas diárias são %@ maiores que no resto da semana. Programe lançamentos e promoções para a quinta-feira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С пятницы по воскресенье продаж в день на %@ больше, чем в остальные дни недели. Планируйте релизы и акции на четверг."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma ile Pazar arası, haftanın geri kalanına göre günlük %@ daha fazla satış getiriyor. Sürümleri ve promosyonları Perşembe gününe denk getirin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från fredag till söndag säljer du %@ mer per dag än resten av veckan. Planera versioner och kampanjer till torsdagen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra fredag til søndag selger du %@ mer per dag enn resten av uken. Planlegg versjoner og kampanjer til torsdag."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra fredag til søndag sælger du %@ mere pr. dag end resten af ugen. Planlæg versioner og kampagner til torsdag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perjantaista sunnuntaihin myyntiä on %@ enemmän päivässä kuin muulla viikolla. Ajoita julkaisut ja kampanjat torstaille."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od piątku do niedzieli sprzedaż dziennie jest o %@ wyższa niż w pozostałe dni tygodnia. Zaplanuj wydania i promocje na czwartek."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od pátku do neděle přinášejí o %@ více prodejů denně než zbytek týdne. Vydání a akce načasujte na čtvrtek."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De vineri până duminică se vând cu %@ mai mult pe zi decât în restul săptămânii. Programează versiunile și promoțiile pentru joi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З п’ятниці по неділю продажів на %@ більше за день, ніж в інші дні тижня. Плануйте випуски та акції на четвер."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από την Παρασκευή έως την Κυριακή έχετε %@ περισσότερες πωλήσεις την ημέρα από την υπόλοιπη εβδομάδα. Προγραμματίστε εκδόσεις και προωθήσεις για την Πέμπτη."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周五到周日每天的销售额比一周中的其他日子高出 %@。可把发布和促销安排在周四。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週五到週日每天的銷售額比一週中的其他日子高出 %@。可把發布和促銷安排在週四。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金曜から日曜は、週のほかの日より1日あたりの売上が%@多くなっています。リリースやプロモーションは木曜に合わせましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금요일부터 일요일까지는 주중보다 하루 판매량이 %@ 많아요. 출시와 프로모션은 목요일에 맞추세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันศุกร์ถึงอาทิตย์มียอดขายต่อวันมากกว่าช่วงที่เหลือของสัปดาห์ %@ ควรกำหนดการเผยแพร่และโปรโมชันให้ตรงกับวันพฤหัสบดี"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "De sexta a domingo vendem-se mais %@ por dia do que no resto da semana. Programe versões e promoções para quinta-feira."
          }
        }
      }
    },
