    "Crashes per session are %@× last month's rate. Check crash reports in Xcode Organizer, starting with recent releases.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fallades per sessió són %@× la taxa del mes passat. Revisa els informes de fallades a Xcode Organizer, començant per les versions recents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abstürze pro Sitzung liegen beim %@-Fachen des Vormonats. Prüfen Sie die Absturzberichte im Xcode Organizer, beginnend mit den neuesten Releases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fallos por sesión son %@× la tasa del mes pasado. Revisa los informes de fallos en Xcode Organizer, empezando por las versiones recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantages par session atteignent %@× le taux du mois dernier. Consultez les rapports de plantage dans l'Organizer de Xcode, en commençant par les versions récentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I crash per sessione sono %@× il tasso del mese scorso. Controlla i report dei crash in Xcode Organizer, partendo dalle versioni più recenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Crashes per sessie zijn %@× het niveau van vorige maand. Bekijk crashrapporten in Xcode Organizer, te beginnen met recente releases."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As falhas por sessão estão %@× acima da taxa do mês passado. Confira os relatórios de falhas no Xcode Organizer, começando pelas versões recentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбоев на сеанс: %@× от показателя прошлого месяца. Проверьте отчёты о сбоях в Xcode Organizer, начиная с последних релизов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum başına çökmeler geçen ay oranının %@ katı. Xcode Organizer'daki çökme raporlarını, en son sürümlerden başlayarak kontrol edin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krascher per session är %@× förra månadens nivå. Kontrollera kraschrapporterna i Xcode Organizer, börja med de senaste versionerna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krasj per økt er %@× forrige måneds rate. Sjekk krasjrapportene i Xcode Organizer, og start med de nyeste versjonene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedbrud pr. session er %@× sidste måneds rate. Tjek nedbrudsrapporterne i Xcode Organizer, og start med de nyeste versioner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaatumisia istuntoa kohden on %@× viime kuun tasoon nähden. Tarkista kaatumisraportit Xcoden Organizerissa uusimmista julkaisuista alkaen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Awarie na sesję to %@× wartość z zeszłego miesiąca. Sprawdź raporty awarii w Xcode Organizer, zaczynając od najnowszych wydań."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pády na relaci jsou %@× minulého měsíce. Zkontrolujte přehledy pádů v Xcode Organizeru, počínaje nejnovějšími vydáními."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocările pe sesiune sunt de %@× rata lunii trecute. Verifică rapoartele de blocări în Xcode Organizer, începând cu cele mai recente versiuni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збоїв на сеанс у %@ раза більше, ніж минулого місяця. Перегляньте звіти про збої в Xcode Organizer, починаючи з останніх випусків."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι καταρρεύσεις ανά συνεδρία είναι %@× το ποσοστό του προηγούμενου μήνα. Ελέγξτε τις αναφορές καταρρεύσεων στο Xcode Organizer, ξεκινώντας από τις πρόσφατες εκδόσεις."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次会话的崩溃率是上月的 %@ 倍。请在 Xcode Organizer 中查看崩溃报告，先从最近的版本看起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次工作階段的崩潰率是上月的 %@ 倍。請在 Xcode Organizer 中檢視崩潰報告，先從最近的版本看起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションあたりのクラッシュ率が先月の%@倍になっています。XcodeのOrganizerでクラッシュレポートを確認してください。最近のリリースから見ていくのがおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션당 충돌이 지난달 비율의 %@배예요. Xcode Organizer에서 최근 릴리스부터 충돌 보고서를 확인하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแครชต่อเซสชันอยู่ที่ %@ เท่าของอัตราเดือนที่แล้ว ตรวจสอบรายงานการแครชใน Xcode Organizer โดยเริ่มจากรุ่นล่าสุด"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As falhas por sessão são %@× a taxa do mês passado. Consulte os relatórios de falhas no Xcode Organizer, começando pelas versões mais recentes."
          }
        }
      }
    },
