    "Replies are public, so review before sending.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les respostes són públiques, així que revisa-les abans d'enviar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten sind öffentlich, prüfen Sie sie also vor dem Senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas son públicas, así que revísala antes de enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses sont publiques : relisez avant d'envoyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte sono pubbliche: rileggi prima di inviare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden zijn openbaar, dus controleer ze voordat je verstuurt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas são públicas, então revise antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы публичны, поэтому проверьте текст перед отправкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlar herkese açıktır, bu yüzden göndermeden önce gözden geçirin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar är offentliga, så granska innan du skickar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar er offentlige, så les over før du sender."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar er offentlige, så læs dem igennem, før du sender."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaukset ovat julkisia, joten tarkista ne ennen lähettämistä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi są publiczne, więc sprawdź je przed wysłaniem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi jsou veřejné, takže je před odesláním zkontrolujte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile sunt publice, deci verifică înainte de a trimite."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповіді публічні, тож перевірте перед надсиланням."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι απαντήσεις είναι δημόσιες, οπότε ελέγξτε πριν στείλετε."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复是公开的，发送前请检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆是公開的，傳送前請檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信は公開されるため、送信前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답글은 공개되므로 보내기 전에 검토하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบกลับเป็นสาธารณะ โปรดตรวจทานก่อนส่ง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas são públicas, por isso reveja antes de enviar."
          }
        }
      }
    },
