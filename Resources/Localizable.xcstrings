    "That day's downloads and proceeds, as soon as Apple publishes them.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les descàrregues i ingressos d'aquell dia, tan bon punt Apple els publica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads und Erlöse des Tages, sobald Apple sie veröffentlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas e ingresos de ese día, en cuanto Apple los publica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements et revenus du jour, dès qu'Apple les publie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download e i ricavi di quel giorno, appena Apple li pubblica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De downloads en opbrengsten van die dag, zodra Apple ze publiceert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os downloads e receitas desse dia, assim que a Apple os publica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки и выручка за день, как только Apple их опубликует."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O günün indirmeleri ve gelirleri, Apple yayımlar yayımlamaz."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den dagens nedladdningar och intäkter, så snart Apple publicerar dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens nedlastinger og inntekter, så snart Apple publiserer dem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens downloads og indtægter, så snart Apple udgiver dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kyseisen päivän lataukset ja tuotot heti, kun Apple julkaisee ne."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrania i wpływy z tego dnia, gdy tylko Apple je opublikuje."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stažení a výdělky z toho dne, jakmile je Apple zveřejní."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcările și încasările acelei zile, de îndată ce le publică Apple."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження й надходження за цей день — щойно Apple їх опублікує."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι λήψεις και τα έσοδα εκείνης της ημέρας, μόλις τα δημοσιεύσει η Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当天的下载量和收益，Apple 一发布就会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當天的下載量和收益，Apple 一發布就會顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日のダウンロードと収益が、Appleの公開後すぐに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 게시하는 대로 그날의 다운로드와 수익을 보여 드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดาวน์โหลดและรายได้ของวันนั้น ทันทีที่ Apple เผยแพร่"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências e as receitas desse dia, assim que a Apple as publicar."
          }
        }
      }
    },
    "That's every written review. New ones arrive with each refresh.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquestes són totes les ressenyes escrites. Les noves arriben amb cada actualització."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind alle Rezensionen mit Text. Neue kommen bei jeder Aktualisierung hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esas son todas las reseñas escritas. Las nuevas llegan con cada actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont tous les avis écrits. Les nouveaux arrivent à chaque actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono tutte le recensioni scritte. Le nuove arrivano a ogni aggiornamento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat zijn alle geschreven recensies. Nieuwe komen binnen bij elke vernieuwing."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são todas as resenhas escritas. Novas chegam a cada atualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это все отзывы с текстом. Новые появляются при каждом обновлении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm yazılı yorumlar bu kadar. Yenilerini her yenilemede alırsınız."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var alla skrivna recensioner. Nya kommer med varje uppdatering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var alle skrevne anmeldelser. Nye kommer med hver oppdatering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det var alle skrevne anmeldelser. Nye kommer med hver opdatering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siinä kaikki kirjoitetut arvostelut. Uusia tulee jokaisen päivityksen mukana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wszystkie napisane recenzje. Nowe pojawiają się przy każdym odświeżeniu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To jsou všechny napsané recenze. Nové přicházejí s každým obnovením."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt toate recenziile scrise. Cele noi apar la fiecare reîmprospătare."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це всі письмові відгуки. Нові надходять після кожного оновлення."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές είναι όλες οι γραπτές κριτικές. Οι νέες φτάνουν με κάθε ανανέωση."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这就是全部文字评论。每次刷新后会有新的评论出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這就是全部文字評論。每次重新整理後會有新的評論出現。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コメント付きレビューは以上です。新しいレビューは更新のたびに届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성된 리뷰는 이게 전부예요. 새 리뷰는 새로 고칠 때마다 도착해요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรีวิวที่เขียนทั้งหมด รีวิวใหม่จะมาพร้อมการรีเฟรชแต่ละครั้ง"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são todas as avaliações escritas. As novas chegam a cada atualização."
          }
        }
      }
    },
    "The AI command failed without saying why.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ordre d'IA ha fallat sense indicar el motiu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Befehl ist ohne Angabe von Gründen fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando de IA falló sin dar el motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande IA a échoué sans donner de raison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando IA non è riuscito, senza indicarne il motivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-opdracht is mislukt zonder reden te geven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de IA falhou sem dizer o motivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда ИИ завершилась с ошибкой без объяснения причины."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka komutu nedenini söylemeden başarısız oldu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-kommandot misslyckades utan att säga varför."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-kommandoen mislyktes uten å si hvorfor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-kommandoen mislykkedes uden at sige hvorfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälykomento epäonnistui kertomatta syytä."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie AI nie powiodło się bez podania przyczyny."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příkaz AI selhal bez udání důvodu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Comanda AI a eșuat fără să spună de ce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда ШІ завершилася помилкою без пояснення."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εντολή AI απέτυχε χωρίς να πει γιατί."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 命令失败了，但没有说明原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 指令失敗了，但沒有說明原因。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIコマンドが理由を示さずに失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 명령이 이유 없이 실패했어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำสั่ง AI ล้มเหลวโดยไม่บอกสาเหตุ"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de IA falhou sem indicar o motivo."
          }
        }
      }
    },
    "The private key couldn't be read. Paste the full contents of the AuthKey_XXXX.p8 file.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut llegir la clau privada. Enganxa el contingut complet del fitxer AuthKey_XXXX.p8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Schlüssel konnte nicht gelesen werden. Fügen Sie den vollständigen Inhalt der Datei AuthKey_XXXX.p8 ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave privada. Pega el contenido completo del archivo AuthKey_XXXX.p8."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la clé privée. Collez le contenu complet du fichier AuthKey_XXXX.p8."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la chiave privata. Incolla l’intero contenuto del file AuthKey_XXXX.p8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De privésleutel kon niet worden gelezen. Plak de volledige inhoud van het bestand AuthKey_XXXX.p8."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a chave privada. Cole o conteúdo completo do arquivo AuthKey_XXXX.p8."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать закрытый ключ. Вставьте полное содержимое файла AuthKey_XXXX.p8."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel anahtar okunamadı. AuthKey_XXXX.p8 dosyasının tüm içeriğini yapıştırın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den privata nyckeln kunde inte läsas. Klistra in hela innehållet i filen AuthKey_XXXX.p8."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den private nøkkelen kunne ikke leses. Lim inn hele innholdet i filen AuthKey_XXXX.p8."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den private nøgle kunne ikke læses. Indsæt hele indholdet af filen AuthKey_XXXX.p8."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksityistä avainta ei voitu lukea. Liitä AuthKey_XXXX.p8-tiedoston koko sisältö."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać klucza prywatnego. Wklej pełną zawartość pliku AuthKey_XXXX.p8."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromý klíč se nepodařilo přečíst. Vložte celý obsah souboru AuthKey_XXXX.p8."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia privată nu a putut fi citită. Lipește tot conținutul fișierului AuthKey_XXXX.p8."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати закритий ключ. Вставте весь вміст файлу AuthKey_XXXX.p8."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του ιδιωτικού κλειδιού. Επικολλήστε ολόκληρο το περιεχόμενο του αρχείου AuthKey_XXXX.p8."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取私钥。请粘贴 AuthKey_XXXX.p8 文件的完整内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取私密金鑰。請貼上 AuthKey_XXXX.p8 檔案的完整內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵を読み取れませんでした。AuthKey_XXXX.p8ファイルの全内容を貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
