        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti insieme una versione a pagamento e una lite, o tutte le app di un marchio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een betaalde en een lite-versie samen, of alle apps van één merk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte uma versão paga e uma lite, ou todos os apps de uma marca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объедините платную и lite-версию или все приложения одного бренда."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretli ve lite sürümü ya da bir markanın tüm uygulamalarını bir araya getirin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå ihop en betalversion och en lite-version, eller alla appar från ett varumärke."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå sammen en betalt versjon og en lite-versjon, eller alle appene til ett merke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saml en betalt version og en lite-version, eller alle apps fra ét mærke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä maksullinen ja lite-versio tai kaikki saman brändin sovellukset."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz wersję płatną i lite albo wszystkie aplikacje jednej marki."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojte placenou a lite verzi nebo všechny aplikace jedné značky."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pune laolaltă o versiune plătită și una lite, sau toate aplicațiile unui brand."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Об’єднайте платну та lite-версії або всі застосунки одного бренду."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδυάστε μια εκδοχή επί πληρωμή και μια lite, ή όλες τις εφαρμογές ενός brand."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把付费版和精简版放在一起，或把同一品牌的所有 App 放在一起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把付費版和精簡版放在一起，或把同一品牌的所有 App 放在一起。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有料版とLite版をまとめたり、同じブランドのすべてのAppをまとめたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유료 버전과 라이트 버전, 또는 한 브랜드의 모든 앱을 묶어 보세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รวมเวอร์ชันเสียเงินกับเวอร์ชันไลท์เข้าด้วยกัน หรือรวมทุกแอปของแบรนด์เดียวกัน"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte uma versão paga e uma versão lite, ou todas as apps de uma marca."
          }
        }
      }
    },
