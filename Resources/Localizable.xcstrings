    "Your App Store Connect numbers, on your Mac. It reads Apple's reports and tells you what changed.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves xifres d'App Store Connect, al teu Mac. Llegeix els informes d'Apple i t'explica què ha canviat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre App Store Connect-Zahlen, auf Ihrem Mac. Vane liest die Berichte von Apple und sagt Ihnen, was sich geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cifras de App Store Connect, en tu Mac. Lee los informes de Apple y te cuenta qué ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos chiffres App Store Connect, sur votre Mac. Vane lit les rapports d'Apple et vous dit ce qui a changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi numeri di App Store Connect, sul tuo Mac. Legge i report di Apple e ti dice cosa è cambiato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je App Store Connect-cijfers, op je Mac. Vane leest Apples rapporten en vertelt je wat er veranderd is."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus números do App Store Connect, no seu Mac. Ele lê os relatórios da Apple e conta o que mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные App Store Connect на вашем Mac. Vane читает отчёты Apple и сообщает, что изменилось."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect rakamlarınız, Mac'inizde. Apple'ın raporlarını okur ve neyin değiştiğini söyler."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina App Store Connect-siffror, på din Mac. Den läser Apples rapporter och berättar vad som har ändrats."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect-tallene dine, på Macen din. Den leser Apples rapporter og forteller deg hva som har endret seg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine App Store Connect-tal, på din Mac. Den læser Apples rapporter og fortæller dig, hvad der har ændret sig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connect -lukusi Macillasi. Se lukee Applen raportit ja kertoo, mikä on muuttunut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje liczby z App Store Connect, na Twoim Macu. Czyta raporty Apple i mówi, co się zmieniło."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše čísla z App Store Connect, na vašem Macu. Čte přehledy od Applu a říká vám, co se změnilo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifrele tale din App Store Connect, pe Mac. Citește rapoartele Apple și îți spune ce s-a schimbat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші дані App Store Connect на вашому Mac. Vane читає звіти Apple й розповідає, що змінилося."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αριθμοί σας από το App Store Connect, στο Mac σας. Διαβάζει τις αναφορές της Apple και σας λέει τι άλλαξε."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 App Store Connect 数据，就在你的 Mac 上。它会读取 Apple 的报告，并告诉你发生了什么变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 App Store Connect 資料，就在你的 Mac 上。它會讀取 Apple 的報告，並告訴你發生了什麼變化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store Connectの数値を、Macで。Appleのレポートを読み取り、何が変わったかをお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 보는 내 App Store Connect 숫자예요. Apple의 보고서를 읽고 무엇이 바뀌었는지 알려 드려요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเลข App Store Connect ของคุณบน Mac อ่านรายงานของ Apple แล้วบอกว่ามีอะไรเปลี่ยนไป"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus números do App Store Connect, no seu Mac. Lê os relatórios da Apple e diz-lhe o que mudou."
          }
        }
      }
    },
    "Your App Store Connect numbers, read for you.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves xifres d'App Store Connect, llegides per tu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre App Store Connect-Zahlen, für Sie gelesen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cifras de App Store Connect, leídas por ti."
          }
        },
