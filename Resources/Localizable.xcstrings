    "A reply often turns a 1-star review into an update. %lld of your last 10 reviews are 1–2 stars without a response.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A reply often turns a 1-star review into an update. %lld of your last 10 reviews is 1–2 stars without a response."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A reply often turns a 1-star review into an update. %lld of your last 10 reviews are 1–2 stars without a response."
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respuesta suele convertir una reseña de 1 estrella en una actualización. %lld de tus últimas 10 reseñas son de 1–2 estrellas sin respuesta."
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une réponse transforme souvent un avis 1 étoile en avis mis à jour. %lld de vos 10 derniers avis a 1 ou 2 étoiles et aucune réponse."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Une réponse transforme souvent un avis 1 étoile en avis mis à jour. %lld de vos 10 derniers avis ont 1 ou 2 étoiles et aucune réponse."
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta spesso trasforma una recensione da 1 stella in un aggiornamento. %lld delle tue ultime 10 recensioni hanno 1–2 stelle e nessuna risposta."
          }
        }
      }
    },
