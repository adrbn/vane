    "Edit your metadata and answer reviews in one place.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita les metadades i respon ressenyes en un sol lloc."
          }
        },
        "de": {
          "stringUnit": {
