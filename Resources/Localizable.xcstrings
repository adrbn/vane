          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Bewertungen pro 1.000 Downloads seit diesem Release, zuvor %2$@. Prüfen Sie, ob sich Ihre Bewertungsaufforderung geändert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ ratings per 1,000 downloads since this release, down from %2$@. Check whether your rating prompt changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ valoraciones por cada 1000 descargas desde esta versión, frente a %@. Comprueba si ha cambiado tu solicitud de valoración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ notes pour 1 000 téléchargements depuis cette version, contre %@ avant. Vérifiez si votre demande de note a changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ valutazioni ogni 1.000 download da questa versione, in calo rispetto a %@. Controlla se hai cambiato la richiesta di valutazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ beoordelingen per 1.000 downloads sinds deze release, eerder %2$@. Controleer of je beoordelingsverzoek is veranderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ avaliações por 1.000 downloads desde esta versão, ante %2$@. Verifique se o pedido de avaliação mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ оценок на 1000 загрузок с момента этого релиза, раньше было %2$@. Проверьте, не изменился ли запрос оценки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümden beri her 1.000 indirmede %1$@ puanlama; önceden %2$@ idi. Puanlama isteminizin değişip değişmediğini kontrol edin."
          }
        }
      }
    },
    "%@ returned nothing. Run `%@` once in Terminal to check you're signed in.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no ha retornat res. Executa `%2$@` una vegada al Terminal per comprovar que has iniciat la sessió."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat nichts zurückgegeben. Führen Sie `%2$@` einmal im Terminal aus, um zu prüfen, ob Sie angemeldet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ returned nothing. Run `%2$@` once in Terminal to check you're signed in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no devolvió nada. Ejecuta `%@` una vez en Terminal para comprobar que has iniciado sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a rien renvoyé. Exécutez `%@` une fois dans Terminal pour vérifier que vous êtes connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha restituito nulla. Esegui `%@` una volta nel Terminale per verificare di aver effettuato l’accesso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gaf niets terug. Voer `%2$@` eenmaal uit in Terminal om te controleren of je bent ingelogd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não retornou nada. Execute `%2$@` uma vez no Terminal para confirmar que você está conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда %1$@ ничего не вернула. Выполните `%2$@` один раз в Терминале, чтобы убедиться, что вы вошли в систему."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hiçbir şey döndürmedi. Oturum açtığınızı doğrulamak için Terminal'de bir kez `%2$@` çalıştırın."
          }
        }
      }
    },
    "%@ uses %lld of 100 characters. Every free character is a search term you aren't ranking for.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
