    "Browse traffic is %lld× its usual level, mostly in %@. An App Store feature or chart placement would explain it.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El trànsit d'exploració és %1$lld× el seu nivell habitual, sobretot a %2$@. Un destacat o una posició a les llistes de l'App Store ho explicaria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Browse-Traffic liegt beim %1$lld-Fachen des Üblichen, vor allem in %2$@. Eine Präsentation im App Store oder eine Chartplatzierung wäre eine Erklärung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Browse traffic is %1$lld× its usual level, mostly in %2$@. An App Store feature or chart placement would explain it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tráfico de exploración es %lld× su nivel habitual, sobre todo en %@. Un destacado en el App Store o una posición en las listas lo explicaría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trafic de navigation atteint %lld× son niveau habituel (surtout : %@). Une mise en avant sur l'App Store ou une entrée dans un classement l'expliquerait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il traffico da esplorazione è %lld× il livello abituale, soprattutto in %@. Potrebbe dipendere da una segnalazione o da un posizionamento in classifica sull’App Store."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bladerverkeer is %1$lld× het gebruikelijke niveau, vooral in %2$@. Een App Store-aanbeveling of ranglijstplek zou dit verklaren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tráfego de navegação está %1$lld× acima do nível habitual, principalmente em %2$@. Um destaque na App Store ou uma posição nas paradas explicaria isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трафик из обзора: %1$lld× от обычного уровня, в основном в %2$@. Это могла бы объяснить подборка App Store или место в чарте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göz atma trafiği olağan seviyesinin %1$lld katı; çoğunlukla %2$@. Bir App Store öne çıkarması veya liste yerleşimi bunu açıklayabilir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafiken från bläddring är %1$lld× över den vanliga nivån, mest i %2$@. En App Store-presentation eller listplacering skulle kunna förklara det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafikken fra nettlesing er %1$lld× det vanlige nivået, mest i %2$@. En App Store-fremheving eller listeplassering kan forklare det."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafikken fra browsing er %1$lld× det sædvanlige niveau, mest i %2$@. En App Store-fremhævning eller listeplacering kan forklare det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selausliikenne on %1$lld× tavanomaista, enimmäkseen alueella %2$@. App Storen esittely tai listasijoitus voisi selittää sen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruch z przeglądania jest %1$lld× wyższy niż zwykle, głównie w: %2$@. Może to wyjaśniać wyróżnienie w App Store lub miejsce na liście."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Provoz z procházení je %1$lld× vyšší než obvykle, hlavně v: %2$@. Mohlo by to vysvětlit zařazení v App Storu nebo umístění v žebříčku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Traficul din navigare este de %1$lld× nivelul obișnuit, mai ales în %2$@. O prezentare sau o poziție în clasamentele App Store ar putea explica asta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трафік в огляді у %1$lld раз вищий за звичний, здебільшого в %2$@. Це могла б пояснити добірка App Store або місце в чарті."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επισκεψιμότητα περιήγησης είναι %1$lld× το συνηθισμένο επίπεδο, κυρίως σε %2$@. Μια προβολή στο App Store ή μια θέση στα charts θα το εξηγούσε."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览流量是平时的 %1$lld 倍，主要来自 %2$@。可能是 App Store 推荐或榜单位置带来的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽流量是平時的 %1$lld 倍，主要來自 %2$@。可能是 App Store 推薦或榜單位置帶來的。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウズのトラフィックが通常の%1$lld倍になっており、主に%2$@からです。App Storeでの特集やチャート掲載が理由と考えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "둘러보기 트래픽이 평소의 %1$lld배예요. 주로 %2$@에서 발생했어요. App Store 추천 또는 차트 노출이 원인일 수 있어요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทราฟฟิกจากการเรียกดูสูงกว่าระดับปกติ %1$lld เท่า ส่วนใหญ่ใน %2$@ อาจเป็นเพราะ App Store แนะนำแอปหรือติดอันดับชาร์ต"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O tráfego de navegação está %1$lld× acima do nível habitual, sobretudo em %2$@. Um destaque na App Store ou uma posição nos gráficos explicaria isto."
          }
        }
      }
    },
