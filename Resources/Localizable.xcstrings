    "Users and Access → Integrations → App Store Connect API. Give it the Sales and Reports role.": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuaris i accés → Integracions → API d'App Store Connect. Dona-li el rol Vendes i informes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer und Zugriff → Integrationen → App Store Connect API. Geben Sie ihm die Rolle „Vertrieb und Berichte“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuarios y acceso → Integraciones → API de App Store Connect. Dale el rol Ventas e informes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisateurs et accès → Intégrations → API App Store Connect. Attribuez-lui le rôle Ventes et rapports."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utenti e accesso → Integrazioni → API App Store Connect. Assegnale il ruolo Vendite e report."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikers en toegang → Integraties → App Store Connect API. Geef de sleutel de rol Verkoop en rapporten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuários e Acesso → Integrações → API do App Store Connect. Atribua a função Vendas e Relatórios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Пользователи и доступ» → «Интеграции» → API App Store Connect. Назначьте ему роль «Продажи и отчёты»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcılar ve Erişim → Entegrasyonlar → App Store Connect API. Ona Satışlar ve Raporlar rolünü verin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Users and Access → Integrations → App Store Connect API. Ge den rollen Sales and Reports."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Users and Access → Integrations → App Store Connect API. Gi den rollen Sales and Reports."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Users and Access → Integrations → App Store Connect API. Giv den rollen Sales and Reports."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttäjät ja käyttöoikeudet → Integraatiot → App Store Connect API. Anna sille Myynti ja raportit -rooli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownicy i dostęp → Integracje → App Store Connect API. Nadaj mu rolę Sprzedaż i raporty."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uživatelé a přístup → Integrace → App Store Connect API. Přidělte mu roli Prodej a přehledy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizatori și acces → Integrări → App Store Connect API. Dă-i rolul Vânzări și rapoarte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Користувачі та доступ → Інтеграції → App Store Connect API. Надайте йому роль «Продажі та звіти»."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρήστες και πρόσβαση → Ενσωματώσεις → App Store Connect API. Δώστε του τον ρόλο Πωλήσεις και αναφορές."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户与访问 → 集成 → App Store Connect API。为其授予“销售和报告”角色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者與存取權 → 整合 → App Store Connect API。為其授予「銷售和報告」角色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザとアクセス → 統合 → App Store Connect API。「セールスおよびレポート」ロールを付与します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 및 액세스 → 통합 → App Store Connect API. Sales and Reports 역할을 부여하세요."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ใช้และการเข้าถึง → การผสานรวม → App Store Connect API ให้บทบาท Sales and Reports"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizadores e Acesso → Integrações → API do App Store Connect. Atribua-lhe a função Vendas e Relatórios."
          }
        }
      }
    },
